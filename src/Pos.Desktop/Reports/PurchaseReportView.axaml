<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Reports"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Reports.PurchaseReportView"
             x:DataType="vm:PurchaseReportViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Alt+Home" Command="{Binding FirstPageCommand}" />
    <KeyBinding Gesture="Alt+PageUp" Command="{Binding PreviousPageCommand}" />
    <KeyBinding Gesture="Alt+PageDown" Command="{Binding NextPageCommand}" />
    <KeyBinding Gesture="Alt+End" Command="{Binding LastPageCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="TextBlock.figure">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <forms:FormHostView Host="{Binding Forms}">
    <forms:FormHostView.ListContent>
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />

        <!-- Filtros -->
        <Grid Grid.Row="1" ColumnDefinitions="2*,*,*,*,*,Auto,Auto" ColumnSpacing="8">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Classes="label" Text="{x:Static res:Strings.PurchaseReport_Supplier}" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SupplierOptions}" SelectedItem="{Binding SelectedSupplier}"
                      DisplayMemberBinding="{Binding Label, x:DataType=vm:SupplierFilterChoice}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Classes="label" Text="{x:Static res:Strings.PurchaseReport_From}" />
            <CalendarDatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding FromDate}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Classes="label" Text="{x:Static res:Strings.PurchaseReport_To}" />
            <CalendarDatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding ToDate}" />
            <TextBlock Classes="error" Text="{Binding DateError}" IsVisible="{Binding DateError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="4">
            <TextBlock Classes="label" Text="{x:Static res:Strings.PurchaseReport_MinTotal}" />
            <TextBox Text="{Binding MinTotalText}" MaxLength="12" TextAlignment="Right">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <TextBlock Classes="error" Text="{Binding MinTotalError}" IsVisible="{Binding MinTotalError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <StackPanel Grid.Column="4" Spacing="4">
            <TextBlock Classes="label" Text="{x:Static res:Strings.PurchaseReport_MaxTotal}" />
            <TextBox Text="{Binding MaxTotalText}" MaxLength="12" TextAlignment="Right">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <TextBlock Classes="error" Text="{Binding MaxTotalError}" IsVisible="{Binding MaxTotalError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <CheckBox Grid.Column="5" VerticalAlignment="Bottom" Content="{x:Static res:Strings.PurchaseReport_IncludeVoided}" IsChecked="{Binding IncludeVoided}" />
          <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <Button Classes="accent" MinHeight="40" Content="{x:Static res:Strings.PurchaseReport_Apply}" Command="{Binding ApplyCommand}" />
            <Button MinHeight="40" Content="{x:Static res:Strings.PurchaseReport_Open}" Command="{Binding OpenPurchaseCommand}" />
          </StackPanel>
        </Grid>

        <!-- Resumen de todo el filtro (FR-021): solo compras vigentes -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="32">
          <StackPanel>
            <TextBlock Classes="label" Text="{x:Static res:Strings.PurchaseReport_Count}" />
            <TextBlock Classes="figure" Text="{Binding CountText}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="{x:Static res:Strings.PurchaseReport_SubtotalSum}" />
            <TextBlock Classes="figure" Text="{Binding SubtotalSumText}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="{x:Static res:Strings.PurchaseReport_TaxSum}" />
            <TextBlock Classes="figure" Text="{Binding TaxSumText}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="{x:Static res:Strings.PurchaseReport_TotalSum}" />
            <TextBlock Classes="figure" Text="{Binding TotalSumText}" />
          </StackPanel>
          <TextBlock Classes="error" FontSize="13" VerticalAlignment="Center" Text="{Binding ErrorMessage}"
                     IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <!-- Encabezados -->
        <Grid Grid.Row="3" Margin="12,0" ColumnDefinitions="110,*,130,70,120,110,120,140,90">
          <Grid.Styles>
            <Style Selector="TextBlock">
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
          </Grid.Styles>
          <TextBlock Grid.Column="0" Text="{x:Static res:Strings.PurchaseReport_ColDate}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{x:Static res:Strings.PurchaseReport_ColSupplier}" />
          <TextBlock Grid.Column="2" Text="{x:Static res:Strings.PurchaseReport_ColInvoice}" />
          <TextBlock Grid.Column="3" Text="{x:Static res:Strings.PurchaseReport_ColLines}" TextAlignment="Right" />
          <TextBlock Grid.Column="4" Text="{x:Static res:Strings.PurchaseReport_ColSubtotal}" TextAlignment="Right" />
          <TextBlock Grid.Column="5" Text="{x:Static res:Strings.PurchaseReport_ColTax}" TextAlignment="Right" />
          <TextBlock Grid.Column="6" Text="{x:Static res:Strings.PurchaseReport_ColTotal}" TextAlignment="Right" />
          <TextBlock Grid.Column="7" Text="{x:Static res:Strings.PurchaseReport_ColUser}" Margin="12,0,0,0" />
        </Grid>

        <Panel Grid.Row="4">
          <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" DoubleTapped="OnRowDoubleTapped">
            <ListBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding OpenPurchaseCommand}" />
            </ListBox.KeyBindings>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PurchaseReportItem">
                <Grid ColumnDefinitions="110,*,130,70,120,110,120,140,90" MinHeight="36" Opacity="{Binding RowOpacity}">
                  <Grid.Styles>
                    <Style Selector="TextBlock">
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                  </Grid.Styles>
                  <TextBlock Grid.Column="0" Text="{Binding DateText}" />
                  <TextBlock Grid.Column="1" Text="{Binding SupplierName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding InvoiceNumber}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding LinesText}" TextAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="{Binding SubtotalText}" TextAlignment="Right" />
                  <TextBlock Grid.Column="5" Text="{Binding TaxText}" TextAlignment="Right" />
                  <TextBlock Grid.Column="6" Text="{Binding TotalText}" TextAlignment="Right" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="7" Text="{Binding UserName}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                  <Border Grid.Column="8" IsVisible="{Binding IsVoided}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{x:Static res:Strings.Purchase_VoidedBadge}" FontSize="12" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Margin="12" Text="{x:Static res:Strings.PurchaseReport_Empty}" IsVisible="{Binding IsEmpty}"
                     HorizontalAlignment="Center" VerticalAlignment="Top" />
        </Panel>

        <!-- Paginación -->
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
          <Grid.Styles>
            <Style Selector="Button.pager">
              <Setter Property="MinWidth" Value="44" />
              <Setter Property="MinHeight" Value="44" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
          </Grid.Styles>
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PageSummary}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="pager" Command="{Binding FirstPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_FirstPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_FirstPage}">
              <PathIcon Data="{StaticResource Icon.PageFirst}" />
            </Button>
            <Button Classes="pager" Command="{Binding PreviousPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_PreviousPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_PreviousPage}">
              <PathIcon Data="{StaticResource Icon.PagePrevious}" />
            </Button>
            <Button Classes="pager" Command="{Binding NextPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_NextPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_NextPage}">
              <PathIcon Data="{StaticResource Icon.PageNext}" />
            </Button>
            <Button Classes="pager" Command="{Binding LastPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_LastPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_LastPage}">
              <PathIcon Data="{StaticResource Icon.PageLast}" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </forms:FormHostView.ListContent>
  </forms:FormHostView>
</UserControl>
