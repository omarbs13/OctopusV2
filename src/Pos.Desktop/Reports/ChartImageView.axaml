<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Reports"
             x:Class="Pos.Desktop.Reports.ChartImageView"
             x:DataType="vm:ChartViewModel"
             MinHeight="240" Height="300">
  <Image Source="{Binding Image}" Stretch="Fill" IsVisible="{Binding HasChart}" />
</UserControl>
