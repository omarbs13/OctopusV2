<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Reports"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:sales="using:Pos.Desktop.Sales"
             x:Class="Pos.Desktop.Reports.CashCountReportView"
             x:DataType="vm:CashCountReportViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" Margin="0,0,12,0">
      <TextBlock Text="{x:Static res:Strings.Reports_CashCount_Title}" FontSize="22" FontWeight="SemiBold" />

      <!-- Filtros -->
      <ContentControl Content="{Binding Picker}" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <StackPanel Spacing="4" MinWidth="220">
          <TextBlock Text="{x:Static res:Strings.Reports_Cashier}" FontWeight="SemiBold" />
          <ComboBox HorizontalAlignment="Stretch"
                    ItemsSource="{Binding CashierOptions}"
                    SelectedItem="{Binding SelectedCashier}"
                    DisplayMemberBinding="{Binding Label, x:DataType=sales:CashierOption}" />
        </StackPanel>
        <!-- Umbral: editable solo con ManageSettings -->
        <StackPanel Spacing="4">
          <TextBlock Text="{x:Static res:Strings.Reports_CashCount_Threshold}" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="90" Text="{Binding ThresholdText}" IsReadOnly="{Binding !CanEditThreshold}" />
            <Button MinHeight="44" IsVisible="{Binding CanEditThreshold}"
                    Content="{x:Static res:Strings.Reports_CashCount_SaveThreshold}"
                    Command="{Binding SaveThresholdCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <TextBlock Text="{Binding ThresholdMessage}"
                 IsVisible="{Binding ThresholdMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- Exportar: Excel y PDF; se deshabilitan sin datos o mientras se genera -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button MinHeight="44" Content="{x:Static res:Strings.Reports_ExportPdf}" Command="{Binding ExportPdfCommand}" />
        <Button MinHeight="44" Content="{x:Static res:Strings.Reports_ExportExcel}" Command="{Binding ExportExcelCommand}" />
        <TextBlock Text="{x:Static res:Strings.Reports_Exporting}" IsVisible="{Binding IsExporting}" VerticalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsExporting}" />
      </StackPanel>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

      <TextBlock Text="{x:Static res:Strings.Reports_NoData}" IsVisible="{Binding IsEmpty}"
                 FontSize="16" Margin="0,24" HorizontalAlignment="Center" />

      <StackPanel Spacing="12" IsVisible="{Binding HasData}">
        <!-- Alerta -->
        <Border IsVisible="{Binding HasAlerts}" Padding="12" CornerRadius="6"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="18" Height="18" Data="{StaticResource Icon.Warning}" />
            <TextBlock Text="{Binding AlertText}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Tarjetas -->
        <WrapPanel>
          <vm:MetricCard Label="{x:Static res:Strings.Reports_CashCount_ClosedShifts}" Value="{Binding ClosedShiftsText}" />
          <vm:MetricCard Label="{x:Static res:Strings.Reports_CashCount_TotalSold}" Value="{Binding TotalSoldText}" />
          <vm:MetricCard Label="{x:Static res:Strings.Reports_CashCount_Accumulated}" Value="{Binding AccumulatedText}" />
        </WrapPanel>

        <!-- Gráfica -->
        <ContentControl Content="{Binding Chart}" />

        <!-- Tabla -->
        <Grid ColumnDefinitions="100,140,130,130,100,100,100,100,100,100,110,70" Margin="12,0">
          <Grid.Styles>
            <Style Selector="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /></Style>
          </Grid.Styles>
          <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Reports_CashCount_ColShift}" />
          <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Reports_CashCount_ColCashier}" />
          <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Reports_CashCount_ColOpened}" />
          <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Reports_CashCount_ColClosed}" />
          <TextBlock Grid.Column="4" Text="{x:Static res:Strings.Reports_CashCount_ColFloat}" TextAlignment="Right" />
          <TextBlock Grid.Column="5" Text="{x:Static res:Strings.Reports_CashCount_ColSold}" TextAlignment="Right" />
          <TextBlock Grid.Column="6" Text="{x:Static res:Strings.Reports_CashCount_ColDeposits}" TextAlignment="Right" />
          <TextBlock Grid.Column="7" Text="{x:Static res:Strings.Reports_CashCount_ColWithdrawals}" TextAlignment="Right" />
          <TextBlock Grid.Column="8" Text="{x:Static res:Strings.Reports_CashCount_ColExpected}" TextAlignment="Right" />
          <TextBlock Grid.Column="9" Text="{x:Static res:Strings.Reports_CashCount_ColCounted}" TextAlignment="Right" />
          <TextBlock Grid.Column="10" Text="{x:Static res:Strings.Reports_CashCount_ColDifference}" TextAlignment="Right" />
          <TextBlock Grid.Column="11" Text="{x:Static res:Strings.Reports_CashCount_ColPercent}" TextAlignment="Right" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CashCountRowItem">
              <Grid ColumnDefinitions="100,140,130,130,100,100,100,100,100,100,110,70" Margin="12,0" MinHeight="36">
                <Grid.Styles>
                  <Style Selector="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>
                </Grid.Styles>
                <TextBlock Grid.Column="0" Text="{Binding Shift}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Cashier}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding OpenedText}" />
                <TextBlock Grid.Column="3" Text="{Binding ClosedText}" />
                <TextBlock Grid.Column="4" Text="{Binding FloatText}" TextAlignment="Right" />
                <TextBlock Grid.Column="5" Text="{Binding SoldText}" TextAlignment="Right" />
                <TextBlock Grid.Column="6" Text="{Binding DepositsText}" TextAlignment="Right" />
                <TextBlock Grid.Column="7" Text="{Binding WithdrawalsText}" TextAlignment="Right" />
                <TextBlock Grid.Column="8" Text="{Binding ExpectedText}" TextAlignment="Right" />
                <TextBlock Grid.Column="9" Text="{Binding CountedText}" TextAlignment="Right" />
                <TextBlock Grid.Column="10" Text="{Binding DifferenceText}" TextAlignment="Right" FontWeight="SemiBold" />
                <StackPanel Grid.Column="11" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                  <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Warning}" IsVisible="{Binding IsAlert}" />
                  <TextBlock Text="{Binding PercentText}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
