<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Customers"
             xmlns:sales="using:Pos.Desktop.Sales"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Customers.RegisterPaymentView"
             x:DataType="vm:RegisterPaymentViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding RegisterCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>

  <Border Width="420" Padding="16" CornerRadius="8" BorderThickness="1" Margin="0,0,0,12"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
    <StackPanel Spacing="10">
      <TextBlock Text="{x:Static res:Strings.Payment_RegisterTitle}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding BalanceText}" FontSize="16" />
      <TextBlock Text="{x:Static res:Strings.Payment_FifoHint}" FontSize="12" Opacity="0.75" />

      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.Payment_Amount}" IsRequired="True" />
        <TextBox x:Name="AmountBox" Text="{Binding AmountText}" MinHeight="44" MaxLength="12" />
        <TextBlock Text="{Binding AmountError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding AmountError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.Payment_Method}" />
        <ComboBox HorizontalAlignment="Stretch" MinHeight="44" ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}"
                  DisplayMemberBinding="{Binding Label, x:DataType=sales:PaymentMethodOption}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.Payment_Reference}" />
        <TextBox Text="{Binding Reference}" MinHeight="44" MaxLength="50" />
      </StackPanel>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="accent" MinWidth="110" MinHeight="44" Content="{x:Static res:Strings.Payment_Register}" Command="{Binding RegisterCommand}" />
        <Button MinWidth="110" MinHeight="44" Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CloseCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
