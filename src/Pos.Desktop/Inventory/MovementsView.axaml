<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Inventory"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Inventory.MovementsView"
             x:DataType="vm:MovementsViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding RegisterMovementCommand}" />
    <KeyBinding Gesture="Alt+Home" Command="{Binding FirstPageCommand}" />
    <KeyBinding Gesture="Alt+PageUp" Command="{Binding PreviousPageCommand}" />
    <KeyBinding Gesture="Alt+PageDown" Command="{Binding NextPageCommand}" />
    <KeyBinding Gesture="Alt+End" Command="{Binding LastPageCommand}" />
  </UserControl.KeyBindings>

  <forms:FormHostView Host="{Binding Forms}">
    <forms:FormHostView.ListContent>
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Filtros -->
        <Grid Grid.Row="0" ColumnDefinitions="2*,*,*,*" ColumnSpacing="12" Margin="0,0,0,12">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="{x:Static res:Strings.Movements_Product}" FontWeight="SemiBold" />
            <vm:ProductPickerView DataContext="{Binding Picker}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{x:Static res:Strings.Movements_Type}" FontWeight="SemiBold" />
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding TypeOptions}"
                      SelectedItem="{Binding SelectedType}"
                      DisplayMemberBinding="{Binding Label, x:DataType=vm:MovementTypeOption}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="{x:Static res:Strings.Movements_From}" FontWeight="SemiBold" />
            <CalendarDatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding FromDate}" />
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="4">
            <TextBlock Text="{x:Static res:Strings.Movements_To}" FontWeight="SemiBold" />
            <CalendarDatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding ToDate}" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8">
          <Button HorizontalAlignment="Left" Classes="accent"
                  IsVisible="{Binding CanRegisterMovements}"
                  Content="{x:Static res:Strings.Movements_Register}"
                  Command="{Binding RegisterMovementCommand}" />
          <TextBlock Text="{Binding DateRangeError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     IsVisible="{Binding DateRangeError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding StatusMessage}"
                     IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <!-- Encabezados -->
        <Grid Grid.Row="2" Margin="12,0,12,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="125" />
            <ColumnDefinition Width="*" MinWidth="140" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" MinWidth="100" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <Grid.Styles>
            <Style Selector="TextBlock">
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
          </Grid.Styles>
          <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Movements_ColDate}" />
          <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Movements_ColProduct}" />
          <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Movements_ColType}" />
          <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Movements_ColQuantity}" TextAlignment="Right" />
          <TextBlock Grid.Column="4" Text="{x:Static res:Strings.Movements_ColResulting}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="5" Text="{x:Static res:Strings.Movements_ColUnit}" Margin="12,0,0,0" />
          <TextBlock Grid.Column="6" Text="{x:Static res:Strings.Movements_ColReason}" />
          <TextBlock Grid.Column="7" Text="{x:Static res:Strings.Movements_ColReference}" />
          <TextBlock Grid.Column="8" Text="{x:Static res:Strings.Movements_ColUser}" />
        </Grid>

        <!-- Sin acciones de fila: los movimientos no se editan ni se borran -->
        <ListBox Grid.Row="3" ItemsSource="{Binding Rows}" SelectionMode="Single">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MovementRow">
              <Grid>
                <Grid.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                </Grid.Styles>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="125" />
                  <ColumnDefinition Width="*" MinWidth="140" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="*" MinWidth="100" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DateText}" />
                <TextBlock Grid.Column="1" Text="{Binding ProductText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding TypeText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding QuantityText}" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{Binding ResultingText}" TextAlignment="Right" />
                <TextBlock Grid.Column="5" Text="{Binding UnitName}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                <TextBlock Grid.Column="6" Text="{Binding Reason}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Reason}" />
                <TextBlock Grid.Column="7" Text="{Binding Reference}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="8" Text="{Binding UserName}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Margin="12" Text="{x:Static res:Strings.Movements_Empty}"
                   IsVisible="{Binding IsEmpty}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" />

        <!-- Paginación -->
        <Grid Grid.Row="4" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
          <Grid.Styles>
            <Style Selector="Button.pager">
              <Setter Property="MinWidth" Value="44" />
              <Setter Property="MinHeight" Value="44" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
          </Grid.Styles>
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PageSummary}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="pager" Command="{Binding FirstPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_FirstPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_FirstPage}">
              <PathIcon Data="{StaticResource Icon.PageFirst}" />
            </Button>
            <Button Classes="pager" Command="{Binding PreviousPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_PreviousPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_PreviousPage}">
              <PathIcon Data="{StaticResource Icon.PagePrevious}" />
            </Button>
            <Button Classes="pager" Command="{Binding NextPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_NextPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_NextPage}">
              <PathIcon Data="{StaticResource Icon.PageNext}" />
            </Button>
            <Button Classes="pager" Command="{Binding LastPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_LastPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_LastPage}">
              <PathIcon Data="{StaticResource Icon.PageLast}" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </forms:FormHostView.ListContent>
  </forms:FormHostView>
</UserControl>
