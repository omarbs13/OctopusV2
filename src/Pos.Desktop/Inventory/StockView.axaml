<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Inventory"
             xmlns:products="using:Pos.Desktop.Products"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Inventory.StockView"
             x:DataType="vm:StockViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding RegisterMovementCommand}" />
    <KeyBinding Gesture="Alt+Home" Command="{Binding FirstPageCommand}" />
    <KeyBinding Gesture="Alt+PageUp" Command="{Binding PreviousPageCommand}" />
    <KeyBinding Gesture="Alt+PageDown" Command="{Binding NextPageCommand}" />
    <KeyBinding Gesture="Alt+End" Command="{Binding LastPageCommand}" />
  </UserControl.KeyBindings>

  <forms:FormHostView Host="{Binding Forms}">
    <forms:FormHostView.ListContent>
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Barra superior: búsqueda, filtro de estado, inactivos y registrar movimiento -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12" Margin="0,0,0,12">
          <TextBox x:Name="SearchBox" Grid.Column="0"
                   Text="{Binding SearchText}"
                   PlaceholderText="{x:Static res:Strings.Stock_SearchPlaceholder}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchNowCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <ComboBox Grid.Column="1" MinWidth="170"
                    ItemsSource="{Binding FilterOptions}"
                    SelectedItem="{Binding SelectedFilter}"
                    DisplayMemberBinding="{Binding Label, x:DataType=vm:StockFilterOption}" />
          <CheckBox Grid.Column="2"
                    Content="{x:Static res:Strings.Stock_ShowInactive}"
                    IsChecked="{Binding IncludeInactive}" />
          <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
            <Button Classes="accent"
                    IsVisible="{Binding CanRegisterMovements}"
                    Content="{x:Static res:Strings.Stock_Register}"
                    Command="{Binding RegisterMovementCommand}" />
            <Button IsVisible="{Binding CanManageProducts}"
                    Content="{Binding CriticalActionText}"
                    Command="{Binding ToggleCriticalCommand}" />
          </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Margin="12,0,12,8" Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Encabezados -->
        <Grid Grid.Row="2" Margin="12,0,12,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="150" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="130" />
          </Grid.ColumnDefinitions>
          <Grid.Styles>
            <Style Selector="TextBlock">
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
          </Grid.Styles>
          <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Stock_ColName}" />
          <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Stock_ColSku}" />
          <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Stock_ColOnHand}" TextAlignment="Right" />
          <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Stock_ColUnit}" Margin="12,0,0,0" />
          <TextBlock Grid.Column="4" Text="{x:Static res:Strings.Stock_ColMinimum}" TextAlignment="Right" />
          <TextBlock Grid.Column="5" Text="{x:Static res:Strings.Stock_ColStatus}" Margin="12,0,0,0" />
        </Grid>

        <ListBox x:Name="StockList" Grid.Row="3"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow}"
                 DoubleTapped="OnRowDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StockRow">
              <Grid Opacity="{Binding IsActive, Converter={x:Static products:InactiveOpacityConverter.Instance}}">
                <Grid.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                </Grid.Styles>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="150" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Sku}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding OnHandText}" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{Binding UnitName}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                <TextBlock Grid.Column="4" Text="{Binding MinimumText}" TextAlignment="Right" />
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                  <Border CornerRadius="4" Padding="6,2"
                          Background="{Binding Status, Converter={x:Static vm:StockStatusBrushConverter.Instance}}">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" />
                  </Border>
                  <TextBlock Text="{x:Static res:Strings.Stock_Inactive}" FontSize="12" IsVisible="{Binding !IsActive}" />
                  <TextBlock Text="{x:Static res:Strings.Stock_Critical}" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding IsCritical}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Margin="12" Text="{Binding EmptyMessage}"
                   IsVisible="{Binding IsEmpty}" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Top" />

        <!-- Paginación -->
        <Grid Grid.Row="4" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
          <Grid.Styles>
            <Style Selector="Button.pager">
              <Setter Property="MinWidth" Value="44" />
              <Setter Property="MinHeight" Value="44" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
          </Grid.Styles>
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PageSummary}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="pager" Command="{Binding FirstPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_FirstPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_FirstPage}">
              <PathIcon Data="{StaticResource Icon.PageFirst}" />
            </Button>
            <Button Classes="pager" Command="{Binding PreviousPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_PreviousPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_PreviousPage}">
              <PathIcon Data="{StaticResource Icon.PagePrevious}" />
            </Button>
            <Button Classes="pager" Command="{Binding NextPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_NextPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_NextPage}">
              <PathIcon Data="{StaticResource Icon.PageNext}" />
            </Button>
            <Button Classes="pager" Command="{Binding LastPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_LastPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_LastPage}">
              <PathIcon Data="{StaticResource Icon.PageLast}" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </forms:FormHostView.ListContent>
  </forms:FormHostView>
</UserControl>
