<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Inventory"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Inventory.MovementEditorView"
             x:DataType="vm:MovementEditorViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.negative">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style Selector="StackPanel.field">
      <Setter Property="Spacing" Value="4" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14" Width="300">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />

    <!-- Producto: fijo desde Existencias, selector con búsqueda desde Movimientos -->
    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.MovementEditor_Product}" IsRequired="True" />
      <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding IsProductFixed}" />
      <vm:ProductPickerView DataContext="{Binding Picker}" IsVisible="{Binding $parent[UserControl].((vm:MovementEditorViewModel)DataContext).ShowPicker}" />
      <TextBlock Classes="error" Text="{Binding ProductError}" IsVisible="{Binding ProductError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.MovementEditor_OnHand}" />
      <TextBlock Text="{Binding OnHandText}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.MovementEditor_Type}" IsRequired="True" />
      <ComboBox HorizontalAlignment="Stretch"
                ItemsSource="{Binding TypeOptions}"
                SelectedItem="{Binding SelectedType}"
                DisplayMemberBinding="{Binding Label, x:DataType=vm:MovementTypeOption}" />
      <TextBlock Classes="error" Text="{Binding TypeError}" IsVisible="{Binding TypeError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.MovementEditor_Quantity}" IsRequired="True" />
      <TextBox x:Name="QuantityBox" Text="{Binding QuantityText}" PlaceholderText="{Binding QuantityHint}" />
      <TextBlock Classes="error" Text="{Binding QuantityError}" IsVisible="{Binding QuantityError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.MovementEditor_Resulting}" />
      <TextBlock Text="{Binding ResultingText}" Classes.negative="{Binding ResultingNegative}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.MovementEditor_Reason}" IsRequired="{Binding IsReasonRequired}" />
      <TextBox x:Name="ReasonBox" Text="{Binding Reason}" MaxLength="250" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
      <TextBlock Classes="error" Text="{Binding ReasonError}" IsVisible="{Binding ReasonError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.MovementEditor_Reference}" />
      <TextBox x:Name="ReferenceBox" Text="{Binding Reference}" MaxLength="50"
               PlaceholderText="{x:Static res:Strings.MovementEditor_ReferenceHint}" />
      <TextBlock Classes="error" Text="{Binding ReferenceError}" IsVisible="{Binding ReferenceError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{x:Static res:Strings.Editor_Save}" Command="{Binding SaveCommand}" Classes="accent" MinWidth="100" />
      <Button Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CancelCommand}" MinWidth="100" />
    </StackPanel>
  </StackPanel>
</UserControl>
