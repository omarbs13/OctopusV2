<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Categories"
             xmlns:res="using:Pos.Desktop.Resources"
             x:Class="Pos.Desktop.Categories.CategoryPicker"
             x:DataType="vm:CategoryPickerViewModel"
             IsVisible="{Binding IsAvailable}">
  <!-- Con más de 15 opciones se puede escribir para buscar; el texto de cada opción es su ToString(). -->
  <ComboBox x:Name="Selector" HorizontalAlignment="Stretch" MinWidth="180"
            ItemsSource="{Binding Options}"
            SelectedItem="{Binding SelectedOption}"
            IsEditable="{Binding IsSearchable}"
            AutomationProperties.Name="{x:Static res:Strings.Category_Field}" />
</UserControl>
