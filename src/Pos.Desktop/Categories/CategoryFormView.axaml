<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Categories"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Categories.CategoryFormView"
             x:DataType="vm:CategoryFormViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="StackPanel.field">
      <Setter Property="Spacing" Value="4" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14" Width="320">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Category_Name}" IsRequired="True" />
      <TextBox x:Name="NameBox" Text="{Binding Name}" MaxLength="50">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <TextBlock Classes="error" Text="{Binding NameError}" IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Category_Description}" />
      <TextBox x:Name="DescriptionBox" Text="{Binding Description}" MaxLength="200"
               AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
      <TextBlock Classes="error" Text="{Binding DescriptionError}" IsVisible="{Binding DescriptionError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <TextBlock Classes="error" FontSize="13" Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{x:Static res:Strings.Editor_Save}" Command="{Binding SaveCommand}" Classes="accent" MinWidth="100" />
      <Button Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CancelCommand}" MinWidth="100" />
    </StackPanel>
  </StackPanel>
</UserControl>
