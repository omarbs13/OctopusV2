<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Pos.Desktop.Shell"
             xmlns:res="using:Pos.Desktop.Resources"
             x:Class="Pos.Desktop.Shell.LockOverlayView"
             x:DataType="shell:LockViewModel">

  <!-- Fondo opaco: oculta por completo el contenido y el menú de la sesión. -->
  <Grid Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <Border Padding="24" CornerRadius="8" BorderThickness="1" Width="380"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="12">
        <PathIcon Data="{StaticResource Icon.Lock}" Width="40" Height="40" HorizontalAlignment="Center" />
        <TextBlock Text="{x:Static res:Strings.Lock_Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding DisplayName}" FontSize="16" HorizontalAlignment="Center" />
        <TextBlock Text="{x:Static res:Strings.Lock_Description}" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8" />

        <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="●" MinHeight="44"
                 PlaceholderText="{x:Static res:Strings.Auth_Password}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" />
          </TextBox.KeyBindings>
        </TextBox>

        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <Button Classes="accent" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Content="{x:Static res:Strings.Lock_Unlock}" Command="{Binding UnlockCommand}" />
        <Button MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Content="{x:Static res:Strings.Lock_SwitchUser}" Command="{Binding SwitchUserCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
