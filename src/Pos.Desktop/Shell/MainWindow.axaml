<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Pos.Desktop.Shell"
        x:Class="Pos.Desktop.Shell.MainWindow"
        x:DataType="shell:RootViewModel"
        Icon="/Assets/pos.ico"
        Title="{Binding WindowTitle}"
        MinWidth="1024" MinHeight="768">

  <!-- Los atajos no hacen nada sin sesión o con la sesión bloqueada (SC-001). -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleMenuCommand}" />
    <KeyBinding Gesture="F9" Command="{Binding OpenPointOfSaleCommand}" />
  </Window.KeyBindings>

  <!-- Desplazamiento global solo si el área cliente es menor que el mínimo (FR-006). El tamaño del
       contenido lo fija MainWindow para que los desplazamientos de cada pantalla sigan funcionando. -->
  <ScrollViewer x:Name="RootScroll"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
    <Grid x:Name="RootContent">
      <!-- Con la sesión bloqueada el contenido se deshabilita: nada del teclado o del lector llega a él. -->
      <ContentControl Content="{Binding Content}" IsEnabled="{Binding !IsLocked}" />
      <ContentControl Content="{Binding LockOverlay}" IsVisible="{Binding IsLocked}" />
    </Grid>
  </ScrollViewer>
</Window>
