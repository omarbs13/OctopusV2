<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Sales"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Sales.ReturnSaleView"
             x:DataType="vm:ReturnSaleViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ConfirmCommand}" />
  </UserControl.KeyBindings>

  <Border Padding="16" CornerRadius="6" BorderThickness="1" MaxWidth="720" HorizontalAlignment="Left"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
    <StackPanel Spacing="10">
      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />

      <!-- Líneas: casilla y cantidad por línea (solo con el módulo Devoluciones) -->
      <StackPanel Spacing="4" IsVisible="{Binding IsFullForm}">
        <Grid ColumnDefinitions="40,*,110,130" Margin="4,0">
          <Grid.Styles>
            <Style Selector="TextBlock">
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
          </Grid.Styles>
          <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Return_ColProduct}" />
          <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Return_ColAvailable}" TextAlignment="Right" />
          <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Return_ColReturn}" TextAlignment="Right" Margin="0,0,4,0" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Lines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReturnLineRow">
              <Grid ColumnDefinitions="40,*,110,130" Margin="4,2">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanReturn}"
                          AutomationProperties.Name="{Binding Name}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding AvailableText}" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBox Grid.Column="3" Text="{Binding QuantityText}" TextAlignment="Right" MinHeight="36"
                         IsEnabled="{Binding IsSelected}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button HorizontalAlignment="Left" MinHeight="44" Command="{Binding SelectAllCommand}"
                Content="{x:Static res:Strings.Return_SelectAll}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.Return_Reason}" IsRequired="True" />
        <TextBox x:Name="ReasonBox" Text="{Binding Reason}" MaxLength="250"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
        <TextBlock Text="{Binding ReasonError}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   IsVisible="{Binding ReasonError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <!-- Compensación y resumen -->
      <StackPanel Spacing="6" IsVisible="{Binding IsFullForm}">
        <TextBlock Text="{x:Static res:Strings.Return_Compensation}" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <RadioButton GroupName="Compensation" IsChecked="{Binding IsRefund}"
                       Content="{x:Static res:Strings.Return_Refund}" />
          <RadioButton GroupName="Compensation" IsChecked="{Binding IsCreditNote}"
                       Content="{x:Static res:Strings.Return_CreditNote}" />
        </StackPanel>
        <TextBlock Text="{Binding SummaryText}" FontSize="16" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Breakdown}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding CashWarning}" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   IsVisible="{Binding CashWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="accent" MinHeight="44" MinWidth="150"
                Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
        <Button MinHeight="44" MinWidth="110"
                Content="{x:Static res:Strings.Return_Keep}" Command="{Binding CloseCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
