<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Sales"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Sales.CouponEntryView"
             x:DataType="vm:CouponEntryViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>

  <Border Padding="16" CornerRadius="6" BorderThickness="1" Width="420"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
    <StackPanel Spacing="10">
      <TextBlock Text="{x:Static res:Strings.Discount_CouponButton}" FontSize="18" FontWeight="SemiBold" />
      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.Discount_CouponCode}" IsRequired="True" />
        <TextBox x:Name="CodeBox" Text="{Binding Code}" MaxLength="30" MinHeight="44" FontSize="18">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="accent" MinHeight="44" MinWidth="110"
                Content="{x:Static res:Strings.Discount_Apply}" Command="{Binding ApplyCommand}" />
        <Button MinHeight="44" MinWidth="110"
                Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CloseCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
