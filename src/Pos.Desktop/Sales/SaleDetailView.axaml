<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Sales"
             xmlns:res="using:Pos.Desktop.Resources"
             x:Class="Pos.Desktop.Sales.SaleDetailView"
             x:DataType="vm:SaleDetailViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Text="{Binding HeaderText}" />
    <TextBlock Text="{Binding CancellationText}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               TextWrapping="Wrap" IsVisible="{Binding IsCancelled}" />

    <!-- Líneas -->
    <TextBlock Classes="heading" Text="{x:Static res:Strings.SaleDetail_Lines}" />
    <Grid ColumnDefinitions="*,120,120,120,130" Margin="12,0,12,0">
      <Grid.Styles>
        <Style Selector="TextBlock">
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
      </Grid.Styles>
      <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Sale_ColName}" />
      <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Sale_ColSku}" />
      <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Sale_ColQuantity}" TextAlignment="Right" />
      <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Sale_ColPrice}" TextAlignment="Right" />
      <TextBlock Grid.Column="4" Text="{x:Static res:Strings.Sale_ColAmount}" TextAlignment="Right" />
    </Grid>
    <ItemsControl ItemsSource="{Binding Lines}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SaleLineRow">
          <Grid ColumnDefinitions="*,120,120,120,130" RowDefinitions="Auto,Auto" Margin="12,2">
            <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" FontSize="12"
                       Text="{Binding ReturnedText}" IsVisible="{Binding HasReturned}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding Sku}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding QuantityText}" TextAlignment="Right" />
            <TextBlock Grid.Column="3" Text="{Binding PriceText}" TextAlignment="Right" />
            <!-- 015: original tachado, descuento y neto de la línea -->
            <StackPanel Grid.Column="4" Grid.RowSpan="2" HorizontalAlignment="Right">
              <TextBlock Text="{Binding OriginalText}" TextAlignment="Right" FontSize="12" Opacity="0.7"
                         TextDecorations="Strikethrough" IsVisible="{Binding HasLineDiscount}" />
              <TextBlock Text="{Binding LineDiscountText}" TextAlignment="Right" FontSize="12" IsVisible="{Binding HasLineDiscount}" />
              <TextBlock Text="{Binding AmountText}" TextAlignment="Right" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Descuentos (015, FR-017) -->
    <StackPanel Spacing="4" IsVisible="{Binding HasDiscounts}">
      <TextBlock Classes="heading" Text="{x:Static res:Strings.SaleDetail_Discounts}" />
      <Grid ColumnDefinitions="90,*,90,100,150,150" Margin="12,0,12,0">
        <Grid.Styles>
          <Style Selector="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /></Style>
        </Grid.Styles>
        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SaleDetail_ColKind}" />
        <TextBlock Grid.Column="2" Text="{x:Static res:Strings.SaleDetail_ColValue}" TextAlignment="Right" />
        <TextBlock Grid.Column="3" Text="{x:Static res:Strings.SaleDetail_ColAmount}" TextAlignment="Right" />
        <TextBlock Grid.Column="4" Text="{x:Static res:Strings.SaleDetail_ColApplied}" Margin="12,0,0,0" />
        <TextBlock Grid.Column="5" Text="{x:Static res:Strings.SaleDetail_ColAuthorized}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Discounts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SaleDiscountRow">
            <Grid ColumnDefinitions="90,*,90,100,150,150" Margin="12,2">
              <TextBlock Grid.Column="0" Text="{Binding KindText}" />
              <TextBlock Grid.Column="1" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding ValueText}" TextAlignment="Right" />
              <TextBlock Grid.Column="3" Text="{Binding AmountText}" TextAlignment="Right" />
              <TextBlock Grid.Column="4" Text="{Binding AppliedBy}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="5" Text="{Binding AuthorizedBy}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding DiscountSummaryText}" HorizontalAlignment="Right" Margin="0,0,12,0" />
    </StackPanel>
    <TextBlock Text="{Binding TotalText}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,12,0" />
    <TextBlock Text="{Binding ReturnedTotalText}" HorizontalAlignment="Right" Margin="0,0,12,0"
               Foreground="{DynamicResource SystemFillColorCautionBrush}"
               IsVisible="{Binding ReturnedTotalText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- Pagos -->
    <TextBlock Classes="heading" Text="{x:Static res:Strings.SaleDetail_Payments}" />
    <Grid ColumnDefinitions="140,130,130,130,*" Margin="12,0,12,0">
      <Grid.Styles>
        <Style Selector="TextBlock">
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
      </Grid.Styles>
      <TextBlock Grid.Column="0" Text="{x:Static res:Strings.SaleDetail_Method}" />
      <TextBlock Grid.Column="1" Text="{x:Static res:Strings.SaleDetail_Amount}" TextAlignment="Right" />
      <TextBlock Grid.Column="2" Text="{x:Static res:Strings.SaleDetail_Received}" TextAlignment="Right" />
      <TextBlock Grid.Column="3" Text="{x:Static res:Strings.SaleDetail_Change}" TextAlignment="Right" />
      <TextBlock Grid.Column="4" Text="{x:Static res:Strings.Checkout_Reference}" Margin="12,0,0,0" />
    </Grid>
    <ItemsControl ItemsSource="{Binding Payments}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SalePaymentRow">
          <Grid ColumnDefinitions="140,130,130,130,*" Margin="12,2">
            <TextBlock Grid.Column="0" Text="{Binding MethodText}" />
            <TextBlock Grid.Column="1" Text="{Binding AmountText}" TextAlignment="Right" />
            <TextBlock Grid.Column="2" Text="{Binding ReceivedText}" TextAlignment="Right" />
            <TextBlock Grid.Column="3" Text="{Binding ChangeText}" TextAlignment="Right" />
            <TextBlock Grid.Column="4" Text="{Binding ReferenceText}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Crédito (014): cliente, saldo de esta venta y estado -->
    <StackPanel Spacing="4" IsVisible="{Binding HasCredit}">
      <TextBlock Classes="heading" Text="{x:Static res:Strings.Credit_Section}" />
      <StackPanel Margin="12,0" Spacing="2">
        <TextBlock Text="{Binding CreditCustomerText}" />
        <TextBlock Text="{Binding CreditBalanceText}" />
        <TextBlock Text="{Binding CreditStatusText}" FontWeight="SemiBold" />
        <Button Content="{x:Static res:Strings.Credit_OpenCustomer}" Command="{Binding OpenCustomerCommand}"
                IsVisible="{Binding ShowCustomerLink}" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>

    <!-- Historial de cancelación y devoluciones (FR-013): solo lectura, sin editar ni eliminar -->
    <StackPanel Spacing="4" IsVisible="{Binding HasHistory}">
      <TextBlock Classes="heading" Text="{x:Static res:Strings.Return_History}" />
      <ItemsControl ItemsSource="{Binding History}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReturnHistoryRow">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="12,2" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <TextBlock Text="{x:Static res:Strings.Return_OutOfWindow}" IsVisible="{Binding IsOutOfReturnWindow}"
               Foreground="{DynamicResource SystemFillColorCautionBrush}" />

    <!-- Reimpresión, devolución y cancelación -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button HorizontalAlignment="Left" MinHeight="44"
              Content="{x:Static res:Strings.SaleDetail_Reprint}"
              Command="{Binding ReprintCommand}" />
      <Button HorizontalAlignment="Left" MinHeight="44"
              Content="{x:Static res:Strings.Return_TitleItems}"
              Command="{Binding ReturnItemsCommand}"
              IsVisible="{Binding CanReturnItems}" />
      <Button Classes="accent" HorizontalAlignment="Left" MinHeight="44"
              Content="{x:Static res:Strings.SaleDetail_CancelSale}"
              Command="{Binding CancelSaleCommand}"
              IsVisible="{Binding CanCancel}" />
    </StackPanel>
    <ContentControl Content="{Binding CancelForm}" />
  </StackPanel>
</UserControl>
