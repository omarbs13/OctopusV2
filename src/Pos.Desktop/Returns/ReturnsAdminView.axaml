<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Returns"
             xmlns:res="using:Pos.Desktop.Resources"
             x:Class="Pos.Desktop.Returns.ReturnsAdminView"
             x:DataType="vm:ReturnsAdminViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.pager">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
  </UserControl.Styles>

  <TabControl>
    <!-- Notas de crédito -->
    <TabItem Header="{x:Static res:Strings.ReturnsAdmin_TabNotes}">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,12,0,0">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
          <TextBox Width="200" MinHeight="44" Text="{Binding FolioFilter}"
                   PlaceholderText="{x:Static res:Strings.ReturnsAdmin_FolioFilter}" />
          <CheckBox VerticalAlignment="Center" IsChecked="{Binding OnlyWithBalance}"
                    Content="{x:Static res:Strings.ReturnsAdmin_OnlyWithBalance}" />
          <Button MinHeight="44" Command="{Binding SearchNotesFromFilterCommand}"
                  Content="{x:Static res:Strings.ReturnsAdmin_Search}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{Binding FolioError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   IsVisible="{Binding FolioError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Grid Grid.Row="2" ColumnDefinitions="130,150,120,120,*" Margin="12,12,12,4">
          <Grid.Styles>
            <Style Selector="TextBlock">
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
          </Grid.Styles>
          <TextBlock Grid.Column="0" Text="{x:Static res:Strings.ReturnsAdmin_ColFolio}" />
          <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ReturnsAdmin_ColDate}" />
          <TextBlock Grid.Column="2" Text="{x:Static res:Strings.ReturnsAdmin_ColAmount}" TextAlignment="Right" />
          <TextBlock Grid.Column="3" Text="{x:Static res:Strings.ReturnsAdmin_ColBalance}" TextAlignment="Right" />
          <TextBlock Grid.Column="4" Text="{x:Static res:Strings.ReturnsAdmin_ColSale}" Margin="16,0,0,0" />
        </Grid>
        <ListBox Grid.Row="3" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" MinHeight="120">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CreditNoteRow">
              <Grid ColumnDefinitions="130,150,120,120,*" MinHeight="36">
                <TextBlock Grid.Column="0" Text="{Binding Folio}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DateText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding InitialText}" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding BalanceText}" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding SaleFolio}" Margin="16,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="3" Text="{x:Static res:Strings.ReturnsAdmin_NotesEmpty}" IsVisible="{Binding NotesEmpty}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" />

        <!-- Detalle de la nota seleccionada -->
        <StackPanel Grid.Row="4" Spacing="4" Margin="0,8,0,0" IsVisible="{Binding HasSelectedNote}">
          <TextBlock Classes="heading" Text="{x:Static res:Strings.ReturnsAdmin_Movements}" />
          <ItemsControl ItemsSource="{Binding Movements}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CreditNoteMovementRow">
                <Grid ColumnDefinitions="150,150,120,*,160" Margin="12,2">
                  <TextBlock Grid.Column="0" Text="{Binding TypeText}" />
                  <TextBlock Grid.Column="1" Text="{Binding DateText}" />
                  <TextBlock Grid.Column="2" Text="{Binding AmountText}" TextAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="{Binding RelatedText}" Margin="16,0,0,0" />
                  <TextBlock Grid.Column="4" Text="{Binding UserName}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button HorizontalAlignment="Left" MinHeight="44" Command="{Binding ReprintCommand}"
                  Content="{x:Static res:Strings.ReturnsAdmin_Reprint}" />
        </StackPanel>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <TextBlock Text="{Binding NotesPageSummary}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="pager" Command="{Binding PreviousNotesPageCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_PreviousPage}">
              <PathIcon Data="{StaticResource Icon.PagePrevious}" />
            </Button>
            <Button Classes="pager" Command="{Binding NextNotesPageCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_NextPage}">
              <PathIcon Data="{StaticResource Icon.PageNext}" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </TabItem>

    <!-- Reintegros pendientes de reversa manual -->
    <TabItem Header="{x:Static res:Strings.ReturnsAdmin_TabReversals}">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,12,0,0">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
          <ComboBox MinWidth="200" MinHeight="44"
                    ItemsSource="{Binding FilterOptions}"
                    SelectedItem="{Binding SelectedFilter}"
                    DisplayMemberBinding="{Binding Label, x:DataType=vm:ReversalFilterOption}" />
          <Button MinHeight="44" Command="{Binding MarkReversedCommand}"
                  Content="{x:Static res:Strings.ReturnsAdmin_MarkReversed}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="130,130,150,120,150,*" Margin="12,12,12,4">
          <Grid.Styles>
            <Style Selector="TextBlock">
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
          </Grid.Styles>
          <TextBlock Grid.Column="0" Text="{x:Static res:Strings.ReturnsAdmin_ColReturn}" />
          <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ReturnsAdmin_ColSale}" />
          <TextBlock Grid.Column="2" Text="{x:Static res:Strings.ReturnsAdmin_ColMethod}" />
          <TextBlock Grid.Column="3" Text="{x:Static res:Strings.ReturnsAdmin_ColAmount}" TextAlignment="Right" />
          <TextBlock Grid.Column="4" Text="{x:Static res:Strings.ReturnsAdmin_ColDate}" Margin="16,0,0,0" />
          <TextBlock Grid.Column="5" Text="{x:Static res:Strings.ReturnsAdmin_ColStatus}" />
        </Grid>
        <ListBox Grid.Row="2" ItemsSource="{Binding Reversals}" SelectedItem="{Binding SelectedReversal}" MinHeight="120">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ReversalRow">
              <Grid ColumnDefinitions="130,130,150,120,150,*" MinHeight="36">
                <TextBlock Grid.Column="0" Text="{Binding ReturnFolio}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SaleFolio}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding MethodText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding AmountText}" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding DateText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding StatusText}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="{x:Static res:Strings.ReturnsAdmin_ReversalsEmpty}" IsVisible="{Binding ReversalsEmpty}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" />
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <TextBlock Text="{Binding ReversalsPageSummary}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="pager" Command="{Binding PreviousReversalsPageCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_PreviousPage}">
              <PathIcon Data="{StaticResource Icon.PagePrevious}" />
            </Button>
            <Button Classes="pager" Command="{Binding NextReversalsPageCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_NextPage}">
              <PathIcon Data="{StaticResource Icon.PageNext}" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </TabItem>

    <!-- Configuración -->
    <TabItem Header="{x:Static res:Strings.ReturnsAdmin_TabSettings}">
      <StackPanel Spacing="8" Margin="0,12,0,0" MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Classes="heading" Text="{x:Static res:Strings.ReturnsAdmin_WindowDays}" TextWrapping="Wrap" />
        <TextBox MinHeight="44" Text="{Binding WindowDaysText}" MaxLength="4" Width="140" HorizontalAlignment="Left" />
        <TextBlock Text="{x:Static res:Strings.ReturnsAdmin_WindowHelp}" FontSize="12" Opacity="0.7" />
        <TextBlock Text="{Binding SettingsError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding SettingsError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding SettingsMessage}"
                   IsVisible="{Binding SettingsMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Classes="accent" MinHeight="44" HorizontalAlignment="Left" Command="{Binding SaveSettingsCommand}"
                Content="{x:Static res:Strings.ReturnsAdmin_Save}" />
      </StackPanel>
    </TabItem>
  </TabControl>
</UserControl>
