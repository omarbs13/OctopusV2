<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Products"
             xmlns:products="using:Pos.Application.Products"
             xmlns:common="using:Pos.Desktop.Common"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Products.ProductsView"
             x:DataType="vm:ProductsViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProductCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding EditCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
    <KeyBinding Gesture="Alt+Home" Command="{Binding FirstPageCommand}" />
    <KeyBinding Gesture="Alt+PageUp" Command="{Binding PreviousPageCommand}" />
    <KeyBinding Gesture="Alt+PageDown" Command="{Binding NextPageCommand}" />
    <KeyBinding Gesture="Alt+End" Command="{Binding LastPageCommand}" />
  </UserControl.KeyBindings>

  <forms:FormHostView Host="{Binding Forms}">
    <forms:FormHostView.ListContent>
        <!-- Listado y búsqueda -->
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Text="{Binding SearchText}"
                     PlaceholderText="{x:Static res:Strings.Products_SearchPlaceholder}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SearchNowCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <CheckBox Grid.Column="1" Margin="12,0"
                      Content="{x:Static res:Strings.Products_ShowInactive}"
                      IsChecked="{Binding IncludeInactive}" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanManage}">
              <Button Classes="accent"
                      Content="{x:Static res:Strings.Products_New}"
                      Command="{Binding NewProductCommand}" />
              <Button Content="{x:Static res:Strings.Products_Edit}"
                      Command="{Binding EditCommand}" />
              <Button Content="{x:Static res:Strings.Products_Delete}"
                      Command="{Binding DeleteCommand}" />
            </StackPanel>
          </Grid>

          <!-- Encabezados -->
          <Grid Grid.Row="1" Margin="12,0,12,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="48" />
              <ColumnDefinition Width="*" MinWidth="150" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="125" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="105" />
              <ColumnDefinition Width="95" />
              <ColumnDefinition Width="82" />
              <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <Grid.Styles>
              <Style Selector="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
              </Style>
            </Grid.Styles>
            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Products_ColImage}" />
            <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Products_ColName}" />
            <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Products_ColSku}" Margin="8,0,0,0" />
            <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Products_ColBarcode}" />
            <TextBlock Grid.Column="4" Text="{x:Static res:Strings.Products_ColUnit}" />
            <TextBlock Grid.Column="5" Text="{x:Static res:Strings.Products_ColStock}" TextAlignment="Right" />
            <TextBlock Grid.Column="6" Text="{x:Static res:Strings.Products_ColPrice}" TextAlignment="Right" />
            <TextBlock Grid.Column="7" Text="{x:Static res:Strings.Products_ColStatus}" Width="70" Margin="12,0,0,0"
                       IsVisible="{Binding IncludeInactive}" />
          </Grid>

          <ListBox x:Name="ProductList"
                   Grid.Row="2"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem}"
                   DoubleTapped="OnProductDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="products:ProductListItemDto">
                <Grid Opacity="{Binding IsActive, Converter={x:Static vm:InactiveOpacityConverter.Instance}}">
                  <Grid.Styles>
                    <Style Selector="TextBlock">
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                  </Grid.Styles>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" MinWidth="150" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="95" />
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="160" />
                  </Grid.ColumnDefinitions>
                  <!-- Miniatura, o indicador neutro si no hay imagen o no se puede leer (003, FR-026) -->
                  <Panel Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Left">
                    <Image x:Name="Thumb" Stretch="Uniform"
                           Source="{Binding Thumbnail, Converter={x:Static common:ThumbnailConverter.Instance}}" />
                    <PathIcon Data="{StaticResource Icon.ImageOff}" Width="20" Height="20" Opacity="0.4"
                              IsVisible="{Binding #Thumb.Source, Converter={x:Static ObjectConverters.IsNull}}" />
                  </Panel>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Sku}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Barcode}" />
                  <TextBlock Grid.Column="4" Text="{Binding UnitName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="5" TextAlignment="Right">
                    <TextBlock.Text>
                      <MultiBinding Converter="{x:Static common:QuantityConverter.Instance}">
                        <Binding Path="OnHandThousandths" />
                        <Binding Path="DecimalPlaces" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Column="6" TextAlignment="Right"
                             Text="{Binding PriceCents, Converter={x:Static common:MoneyConverter.Instance}}" />
                  <TextBlock Grid.Column="7" Width="70" Margin="12,0,0,0"
                             Text="{Binding IsActive, Converter={x:Static vm:ProductStatusConverter.Instance}}"
                             IsVisible="{Binding $parent[ListBox].((vm:ProductsViewModel)DataContext).IncludeInactive}" />
                  <!-- Acción de fila: solo si el producto controla inventario (FR-019) -->
                  <Button Grid.Column="8" Margin="12,0,0,0" MinHeight="32" HorizontalAlignment="Left"
                          Content="{x:Static res:Strings.Products_ViewMovements}"
                          IsVisible="{Binding TracksInventory}"
                          Command="{Binding $parent[ListBox].((vm:ProductsViewModel)DataContext).ViewMovementsCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="2" Margin="12"
                     Text="{x:Static res:Strings.Products_Empty}"
                     IsVisible="{Binding IsEmpty}"
                     HorizontalAlignment="Center" VerticalAlignment="Top" />

          <!-- Paginación (003, FR-006 a FR-008) -->
          <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
            <Grid.Styles>
              <Style Selector="Button.pager">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
              </Style>
            </Grid.Styles>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PageSummary}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <Button Classes="pager" Command="{Binding FirstPageCommand}"
                      ToolTip.Tip="{x:Static res:Strings.Products_FirstPage}"
                      AutomationProperties.Name="{x:Static res:Strings.Products_FirstPage}">
                <PathIcon Data="{StaticResource Icon.PageFirst}" />
              </Button>
              <Button Classes="pager" Command="{Binding PreviousPageCommand}"
                      ToolTip.Tip="{x:Static res:Strings.Products_PreviousPage}"
                      AutomationProperties.Name="{x:Static res:Strings.Products_PreviousPage}">
                <PathIcon Data="{StaticResource Icon.PagePrevious}" />
              </Button>
              <Button Classes="pager" Command="{Binding NextPageCommand}"
                      ToolTip.Tip="{x:Static res:Strings.Products_NextPage}"
                      AutomationProperties.Name="{x:Static res:Strings.Products_NextPage}">
                <PathIcon Data="{StaticResource Icon.PageNext}" />
              </Button>
              <Button Classes="pager" Command="{Binding LastPageCommand}"
                      ToolTip.Tip="{x:Static res:Strings.Products_LastPage}"
                      AutomationProperties.Name="{x:Static res:Strings.Products_LastPage}">
                <PathIcon Data="{StaticResource Icon.PageLast}" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
    </forms:FormHostView.ListContent>
  </forms:FormHostView>
</UserControl>
