<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Products"
             xmlns:products="using:Pos.Application.Products"
             xmlns:common="using:Pos.Desktop.Common"
             xmlns:res="using:Pos.Desktop.Resources"
             x:Class="Pos.Desktop.Products.ProductsView"
             x:DataType="vm:ProductsViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProductCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding EditCommand}" />
    <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
  </UserControl.KeyBindings>

  <Grid ColumnDefinitions="*,Auto">
    <!-- Listado y búsqueda -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
        <TextBox x:Name="SearchBox"
                 Grid.Column="0"
                 Text="{Binding SearchText}"
                 PlaceholderText="{x:Static res:Strings.Products_SearchPlaceholder}">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchNowCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <CheckBox Grid.Column="1" Margin="12,0"
                  Content="{x:Static res:Strings.Products_ShowInactive}"
                  IsChecked="{Binding IncludeInactive}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="accent"
                  Content="{x:Static res:Strings.Products_New}"
                  Command="{Binding NewProductCommand}" />
          <Button Content="{x:Static res:Strings.Products_Edit}"
                  Command="{Binding EditCommand}" />
          <Button Content="{x:Static res:Strings.Products_Delete}"
                  Command="{Binding DeleteCommand}" />
        </StackPanel>
      </Grid>

      <!-- Encabezados -->
      <Grid Grid.Row="1" Margin="12,0,12,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="150" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="125" />
          <ColumnDefinition Width="95" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.Styles>
          <Style Selector="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
        </Grid.Styles>
        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Products_ColName}" />
        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Products_ColSku}" Margin="8,0,0,0" />
        <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Products_ColBarcode}" />
        <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Products_ColPrice}" TextAlignment="Right" />
        <TextBlock Grid.Column="4" Text="{x:Static res:Strings.Products_ColStatus}" Width="70" Margin="12,0,0,0"
                   IsVisible="{Binding IncludeInactive}" />
      </Grid>

      <ListBox x:Name="ProductList"
               Grid.Row="2"
               ItemsSource="{Binding Items}"
               SelectedItem="{Binding SelectedItem}"
               DoubleTapped="OnProductDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="products:ProductListItemDto">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="150" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="95" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Sku}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
              <TextBlock Grid.Column="2" Text="{Binding Barcode}" />
              <TextBlock Grid.Column="3" TextAlignment="Right"
                         Text="{Binding PriceCents, Converter={x:Static common:MoneyConverter.Instance}}" />
              <TextBlock Grid.Column="4" Width="70" Margin="12,0,0,0"
                         Text="{Binding IsActive, Converter={x:Static vm:ProductStatusConverter.Instance}}"
                         IsVisible="{Binding $parent[ListBox].((vm:ProductsViewModel)DataContext).IncludeInactive}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="2" Margin="12"
                 Text="{x:Static res:Strings.Products_Empty}"
                 IsVisible="{Binding IsEmpty}"
                 HorizontalAlignment="Center" VerticalAlignment="Top" />

      <TextBlock Grid.Row="3" Margin="0,8,0,0"
                 Text="{x:Static res:Strings.Products_HasMore}"
                 IsVisible="{Binding HasMore}"
                 Foreground="{DynamicResource SystemFillColorCautionBrush}" />
    </Grid>

    <!-- Editor -->
    <Border Grid.Column="1"
            IsVisible="{Binding IsEditorOpen}"
            Margin="16,0,0,0" Padding="16"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ContentControl Content="{Binding Editor}" />
    </Border>
  </Grid>
</UserControl>
