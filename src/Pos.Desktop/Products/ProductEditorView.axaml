<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Products"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:common="using:Pos.Desktop.Common"
             xmlns:forms="using:Pos.Desktop.Forms"
             xmlns:units="using:Pos.Application.Products.ListUnitsOfMeasure"
             xmlns:categories="using:Pos.Desktop.Categories"
             x:Class="Pos.Desktop.Products.ProductEditorView"
             x:DataType="vm:ProductEditorViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="StackPanel.field">
      <Setter Property="Spacing" Value="4" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14" Width="300">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Editor_Name}" IsRequired="{Binding IsNameRequired}" />
      <TextBox x:Name="NameBox" Text="{Binding Name}" MaxLength="200" />
      <TextBlock Classes="error" Text="{Binding NameError}" IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Editor_Sku}" IsRequired="{Binding IsSkuRequired}" />
      <TextBox x:Name="SkuBox" Text="{Binding Sku}" MaxLength="50" LostFocus="OnSkuLostFocus" />
      <TextBlock Classes="error" Text="{Binding SkuError}" IsVisible="{Binding SkuError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Editor_Barcode}" IsRequired="{Binding IsBarcodeRequired}" />
      <TextBox x:Name="BarcodeBox" Text="{Binding Barcode}" MaxLength="14" />
      <TextBlock Classes="error" Text="{Binding BarcodeError}" IsVisible="{Binding BarcodeError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Editor_Price}" IsRequired="{Binding IsPriceRequired}" />
      <TextBox x:Name="PriceBox" Text="{Binding PriceText}" PlaceholderText="{x:Static res:Strings.Editor_PriceHint}" />
      <TextBlock Classes="error" Text="{Binding PriceError}" IsVisible="{Binding PriceError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Editor_Unit}" IsRequired="{Binding IsUnitRequired}" />
      <ComboBox x:Name="UnitBox"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding Units}"
                IsEnabled="{Binding CanChangeInventorySettings}"
                SelectedValue="{Binding UnitCode}"
                SelectedValueBinding="{Binding Code, x:DataType=units:UnitOfMeasureDto}"
                DisplayMemberBinding="{Binding Name, x:DataType=units:UnitOfMeasureDto}" />
      <TextBlock Classes="error" Text="{Binding UnitCodeError}" IsVisible="{Binding UnitCodeError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <!-- Categoría (016, FR-010): opcional -->
    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Category_Field}" />
      <categories:CategoryPicker x:Name="CategoryBox" DataContext="{Binding Category}" />
      <TextBlock Classes="error" Text="{Binding CategoryError}" IsVisible="{Binding CategoryError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <!-- Inventario (004, FR-001, FR-004, FR-005, FR-006) -->
    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Editor_InventorySection}" />
      <CheckBox x:Name="TracksInventoryBox"
                Content="{x:Static res:Strings.Editor_TracksInventory}"
                IsChecked="{Binding TracksInventory}"
                IsEnabled="{Binding CanChangeInventorySettings}" />
      <TextBlock Classes="error" Text="{Binding TracksInventoryError}" IsVisible="{Binding TracksInventoryError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Text="{x:Static res:Strings.Editor_InventoryLocked}" TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                 IsVisible="{Binding HasMovements}" />
    </StackPanel>

    <StackPanel Classes="field" IsVisible="{Binding TracksInventory}">
      <forms:FieldLabel Text="{x:Static res:Strings.Editor_MinimumStock}" />
      <TextBox x:Name="MinimumStockBox" Text="{Binding MinimumStockText}"
               PlaceholderText="{x:Static res:Strings.Editor_MinimumStockHint}"
               IsEnabled="{Binding TracksInventory}" />
      <TextBlock Classes="error" Text="{Binding MinimumStockError}" IsVisible="{Binding MinimumStockError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field" IsVisible="{Binding TracksInventory}">
      <CheckBox Content="{x:Static res:Strings.Editor_IsCritical}" IsChecked="{Binding IsCritical}" />
      <TextBlock Text="{x:Static res:Strings.Editor_IsCriticalHint}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Editor_OnHand}" />
      <TextBlock Text="{Binding OnHandText}" />
    </StackPanel>

    <!-- Imagen (003, FR-021 a FR-025) -->
    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Editor_Image}" />
      <Border Width="200" Height="200" HorizontalAlignment="Left" CornerRadius="4"
              BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <Panel>
          <Image x:Name="PreviewBox" Stretch="Uniform"
                 Source="{Binding PreviewImage, Converter={x:Static common:ThumbnailConverter.Instance}}" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                      IsVisible="{Binding #PreviewBox.Source, Converter={x:Static ObjectConverters.IsNull}}">
            <PathIcon Data="{StaticResource Icon.ImageOff}" Width="40" Height="40" Opacity="0.5" />
            <TextBlock Text="{x:Static res:Strings.Editor_NoImage}" Opacity="0.7" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8" Spacing="4"
                      IsVisible="{Binding IsProcessingImage}">
            <ProgressBar IsIndeterminate="True" Width="160" />
            <TextBlock Text="{x:Static res:Strings.Editor_ProcessingImage}" HorizontalAlignment="Center" />
          </StackPanel>
        </Panel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
        <Button Command="{Binding SelectImageCommand}"
                Content="{x:Static res:Strings.Editor_SelectImage}"
                IsVisible="{Binding !HasImage}" />
        <Button Command="{Binding SelectImageCommand}"
                Content="{x:Static res:Strings.Editor_ChangeImage}"
                IsVisible="{Binding HasImage}" />
        <Button Command="{Binding RemoveImageCommand}"
                Content="{x:Static res:Strings.Editor_RemoveImage}" />
      </StackPanel>
      <TextBlock Classes="error" Text="{Binding ImageError}" TextWrapping="Wrap"
                 IsVisible="{Binding ImageError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <CheckBox Content="{x:Static res:Strings.Editor_Active}" IsChecked="{Binding IsActive}" IsVisible="{Binding IsEditMode}" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{x:Static res:Strings.Editor_Save}" Command="{Binding SaveCommand}" Classes="accent" MinWidth="100"
              IsEnabled="{Binding !IsProcessingImage}" />
      <Button Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CancelCommand}" MinWidth="100" />
    </StackPanel>
  </StackPanel>
</UserControl>
