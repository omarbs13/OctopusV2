<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Home"
             xmlns:common="using:Pos.Desktop.Common"
             xmlns:res="using:Pos.Desktop.Resources"
             x:Class="Pos.Desktop.Home.HomeView"
             x:DataType="vm:HomeViewModel">

  <UserControl.Styles>
    <!-- Tarjeta: botón sin apariencia de botón; solo reacciona si lleva a alguna pantalla. -->
    <Style Selector="Button.card">
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>
    <Style Selector="Button.card.navigable">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.card.empty, Button.card.error">
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.cardValue">
      <Setter Property="FontSize" Value="34" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.cardMessage">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Spacing="12">
      <TextBlock Text="{x:Static res:Strings.Home_Title}" FontSize="22" FontWeight="SemiBold" />

      <!-- Indicadores -->
      <ItemsControl ItemsSource="{Binding Metrics}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DashboardCard">
            <Button Classes="card"
                    Classes.navigable="{Binding IsNavigable}"
                    Classes.empty="{Binding IsEmpty}"
                    Classes.error="{Binding IsError}"
                    Width="240" MinHeight="130"
                    Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).ActivateCardCommand}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Title}">
              <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                <TextBlock Classes="cardTitle" Text="{Binding Title}" />
                <PathIcon Grid.Column="1" Width="22" Height="22"
                          Data="{Binding Icon, Converter={x:Static common:IconConverter.Instance}}" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="0,12,0,0">
                  <TextBlock Classes="cardValue" Text="{Binding Value}" IsVisible="{Binding ShowValue}" />
                  <!-- Varias cifras navegables (022); la tarjeta exterior no navega -->
                  <ItemsControl ItemsSource="{Binding Segments}" IsVisible="{Binding ShowSegments}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DashboardCardSegment">
                        <Button Margin="0,0,6,0" Padding="8,4" CornerRadius="6" Cursor="Hand"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="{Binding Tone, Converter={x:Static vm:DashboardSegmentToneBrushConverter.Instance}}"
                                Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).ActivateSegmentCommand}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Label}">
                          <StackPanel>
                            <TextBlock Classes="cardValue" Text="{Binding Value}" />
                            <TextBlock Text="{Binding Label}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="cardMessage" Text="{Binding Message}"
                             IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Gráficas -->
      <ItemsControl ItemsSource="{Binding Charts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DashboardCard">
            <Button Classes="card"
                    Classes.navigable="{Binding IsNavigable}"
                    Classes.empty="{Binding IsEmpty}"
                    Classes.error="{Binding IsError}"
                    Width="360" Height="240"
                    Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).ActivateCardCommand}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Title}">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Classes="cardTitle" Text="{Binding Title}" />

                <!-- Sin datos, cargando o con error: ícono y mensaje -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            IsVisible="{Binding !IsReady}">
                  <PathIcon Width="40" Height="40" HorizontalAlignment="Center"
                            Data="{Binding Icon, Converter={x:Static common:IconConverter.Instance}}" />
                  <TextBlock Classes="cardMessage" Text="{Binding Message}" TextAlignment="Center" MaxWidth="280" />
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
                </StackPanel>

                <!-- Con datos: valor y barras -->
                <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding IsReady}">
                  <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                             IsVisible="{Binding Value, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <!-- Serie por día: barras verticales -->
                  <ItemsControl ItemsSource="{Binding Bars}" IsVisible="{Binding !IsHorizontal}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChartBar">
                        <Grid RowDefinitions="Auto,100,Auto" Margin="2,0">
                          <TextBlock Text="{Binding ValueText}" FontSize="9" TextAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                          <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" CornerRadius="3,3,0,0"
                                  Margin="4,2,4,0"
                                  Background="{DynamicResource SystemAccentColor}"
                                  Height="{Binding Ratio, Converter={x:Static vm:BarSizeConverter.Instance}, ConverterParameter=100}" />
                          <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="10" TextAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Ranking: barras horizontales -->
                  <ItemsControl ItemsSource="{Binding Bars}" IsVisible="{Binding IsHorizontal}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChartBar">
                        <StackPanel Margin="0,2">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="12" Margin="8,0,0,0" />
                          </Grid>
                          <Border HorizontalAlignment="Left" Height="10" CornerRadius="3"
                                  Background="{DynamicResource SystemAccentColor}"
                                  Width="{Binding Ratio, Converter={x:Static vm:BarSizeConverter.Instance}, ConverterParameter=310}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
