<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.CashShifts"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.CashShifts.OpenShiftView"
             x:DataType="vm:OpenShiftViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>

  <Border Padding="20" CornerRadius="8" BorderThickness="1" Width="460"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
    <StackPanel Spacing="10">
      <TextBlock Text="{x:Static res:Strings.Shift_OpenTitle}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{x:Static res:Strings.Shift_OpenDescription}" TextWrapping="Wrap" />

      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.Shift_OpeningFloat}" IsRequired="True" />
        <TextBox x:Name="FloatBox" Text="{Binding FloatText}" MinHeight="48" FontSize="20" PlaceholderText="0.00">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBlock Text="{Binding FloatError}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   IsVisible="{Binding FloatError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="action accent" MinHeight="48" MinWidth="140"
                Content="{x:Static res:Strings.Shift_Open}" Command="{Binding ConfirmCommand}" />
        <Button Classes="action" MinHeight="48" MinWidth="110"
                Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CancelCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
