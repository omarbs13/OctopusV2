<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.CashShifts"
             xmlns:res="using:Pos.Desktop.Resources"
             x:Class="Pos.Desktop.CashShifts.ShiftCutDetailView"
             x:DataType="vm:ShiftCutDetailViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>

  <ScrollViewer>
    <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{x:Static res:Strings.Cut_ReadoutLegend}" FontWeight="SemiBold" TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemFillColorCautionBrush}"
                 IsVisible="{Binding IsReadout}" />

      <ItemsControl ItemsSource="{Binding Header}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReconciliationRow">
            <Grid ColumnDefinitions="*,Auto" Margin="12,2">
              <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" MaxWidth="320" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Separator />

      <ItemsControl ItemsSource="{Binding Figures}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReconciliationRow">
            <Grid ColumnDefinitions="*,Auto" Margin="12,3">
              <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap" FontWeight="{Binding IsEmphasis, Converter={x:Static vm:EmphasisWeightConverter.Instance}}" />
              <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" MaxWidth="320" FontWeight="{Binding IsEmphasis, Converter={x:Static vm:EmphasisWeightConverter.Instance}}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" MinHeight="44" Content="{Binding PrintText}" Command="{Binding PrintCommand}" />
        <Button MinHeight="44" Content="{x:Static res:Strings.Cut_Close}" Command="{Binding CancelCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
