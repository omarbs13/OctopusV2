<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:products="using:Pos.Desktop.Products"
             xmlns:about="using:Pos.Desktop.About"
             x:Class="Pos.Desktop.Composition.App"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <!-- Cada pantalla registra aquí la asociación ViewModel → View (sin reflexión). -->
    <DataTemplate DataType="products:ProductsViewModel">
      <products:ProductsView />
    </DataTemplate>
    <DataTemplate DataType="products:ProductEditorViewModel">
      <products:ProductEditorView />
    </DataTemplate>
    <DataTemplate DataType="about:AboutViewModel">
      <about:AboutView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
