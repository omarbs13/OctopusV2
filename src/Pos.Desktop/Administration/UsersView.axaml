<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Administration"
             xmlns:common="using:Pos.Desktop.Common"
             xmlns:products="using:Pos.Desktop.Products"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Administration.UsersView"
             x:DataType="vm:UsersViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewUserCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding EditCommand}" />
    <KeyBinding Gesture="Alt+Home" Command="{Binding FirstPageCommand}" />
    <KeyBinding Gesture="Alt+PageUp" Command="{Binding PreviousPageCommand}" />
    <KeyBinding Gesture="Alt+PageDown" Command="{Binding NextPageCommand}" />
    <KeyBinding Gesture="Alt+End" Command="{Binding LastPageCommand}" />
  </UserControl.KeyBindings>

  <forms:FormHostView Host="{Binding Forms}">
    <forms:FormHostView.ListContent>
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,12">
          <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding SearchText}"
                   PlaceholderText="{x:Static res:Strings.Users_SearchPlaceholder}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchNowCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <CheckBox Grid.Column="1" Margin="12,0" Content="{x:Static res:Strings.Users_ShowInactive}"
                    IsChecked="{Binding IncludeInactive}" />
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="{x:Static res:Strings.Users_New}" Command="{Binding NewUserCommand}" />
            <Button Content="{x:Static res:Strings.Users_Edit}" Command="{Binding EditCommand}" />
            <Button Content="{x:Static res:Strings.Users_ResetPassword}" Command="{Binding ResetPasswordCommand}" />
          </StackPanel>
        </Grid>

        <!-- Encabezados -->
        <Grid Grid.Row="1" Margin="12,0,12,4" ColumnDefinitions="*,160,140,110">
          <Grid.Styles>
            <Style Selector="TextBlock">
              <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
          </Grid.Styles>
          <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Users_ColFullName}" />
          <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Users_ColUserName}" />
          <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Users_ColRole}" />
          <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Users_ColStatus}" />
        </Grid>

        <ListBox x:Name="UserList" Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                 DoubleTapped="OnUserDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:UserRow">
              <Grid ColumnDefinitions="*,160,140,110" MinHeight="40"
                    Opacity="{Binding IsActive, Converter={x:Static products:InactiveOpacityConverter.Instance}}">
                <Grid.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                </Grid.Styles>
                <TextBlock Grid.Column="0" Text="{Binding FullName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding UserName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding RoleText}" />
                <TextBlock Grid.Column="3" Text="{Binding StatusText}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Margin="12" Text="{x:Static res:Strings.Users_Empty}"
                   IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Top" />

        <!-- Paginación -->
        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
          <Grid.Styles>
            <Style Selector="Button.pager">
              <Setter Property="MinWidth" Value="44" />
              <Setter Property="MinHeight" Value="44" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
              <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
          </Grid.Styles>
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PageSummary}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="pager" Command="{Binding FirstPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_FirstPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_FirstPage}">
              <PathIcon Data="{StaticResource Icon.PageFirst}" />
            </Button>
            <Button Classes="pager" Command="{Binding PreviousPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_PreviousPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_PreviousPage}">
              <PathIcon Data="{StaticResource Icon.PagePrevious}" />
            </Button>
            <Button Classes="pager" Command="{Binding NextPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_NextPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_NextPage}">
              <PathIcon Data="{StaticResource Icon.PageNext}" />
            </Button>
            <Button Classes="pager" Command="{Binding LastPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_LastPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_LastPage}">
              <PathIcon Data="{StaticResource Icon.PageLast}" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </forms:FormHostView.ListContent>
  </forms:FormHostView>
</UserControl>
