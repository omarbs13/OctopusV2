<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Administration"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Administration.ResetPasswordView"
             x:DataType="vm:ResetPasswordViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <Border Padding="20" CornerRadius="8" BorderThickness="1" Width="420"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
    <StackPanel Spacing="12">
      <TextBlock Text="{x:Static res:Strings.Reset_Title}" FontSize="20" FontWeight="SemiBold" />

      <!-- Captura -->
      <StackPanel Spacing="12" IsVisible="{Binding IsEditing}">
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />

        <StackPanel Spacing="4">
          <forms:FieldLabel Text="{x:Static res:Strings.Reset_TemporaryPassword}" IsRequired="True" />
          <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="●" MinHeight="44" />
          <TextBlock Classes="error" Text="{Binding PasswordError}" IsVisible="{Binding PasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <forms:FieldLabel Text="{x:Static res:Strings.Auth_ConfirmPassword}" IsRequired="True" />
          <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" MinHeight="44">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <TextBlock Classes="error" Text="{Binding ConfirmPasswordError}" IsVisible="{Binding ConfirmPasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <TextBlock Classes="error" FontSize="13" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Classes="accent" MinHeight="44" MinWidth="130" HorizontalContentAlignment="Center"
                  Content="{x:Static res:Strings.Reset_Confirm}" Command="{Binding ConfirmCommand}" />
          <Button MinHeight="44" MinWidth="110" HorizontalContentAlignment="Center"
                  Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CloseCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- Resultado -->
      <StackPanel Spacing="12" IsVisible="{Binding DoneMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding DoneMessage}" TextWrapping="Wrap" />
        <Button Classes="accent" MinHeight="44" MinWidth="110" HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                Content="{x:Static res:Strings.Common_Accept}" Command="{Binding CloseCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
