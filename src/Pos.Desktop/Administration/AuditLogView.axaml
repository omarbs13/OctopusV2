<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Administration"
             xmlns:res="using:Pos.Desktop.Resources"
             x:Class="Pos.Desktop.Administration.AuditLogView"
             x:DataType="vm:AuditLogViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Alt+Home" Command="{Binding FirstPageCommand}" />
    <KeyBinding Gesture="Alt+PageUp" Command="{Binding PreviousPageCommand}" />
    <KeyBinding Gesture="Alt+PageDown" Command="{Binding NextPageCommand}" />
    <KeyBinding Gesture="Alt+End" Command="{Binding LastPageCommand}" />
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <!-- Filtros (solo lectura: la bitácora no se edita ni se borra) -->
    <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="{x:Static res:Strings.Audit_From}" FontWeight="SemiBold" />
        <CalendarDatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding FromDate}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="{x:Static res:Strings.Audit_To}" FontWeight="SemiBold" />
        <CalendarDatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding ToDate}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="{x:Static res:Strings.Audit_User}" FontWeight="SemiBold" />
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding UserOptions}" SelectedItem="{Binding SelectedUser}"
                  DisplayMemberBinding="{Binding Label, x:DataType=vm:AuditUserOption}" />
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="4">
        <TextBlock Text="{x:Static res:Strings.Audit_Event}" FontWeight="SemiBold" />
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding EventOptions}" SelectedItem="{Binding SelectedEvent}"
                  DisplayMemberBinding="{Binding Label, x:DataType=vm:AuditEventOption}" />
      </StackPanel>
      <StackPanel Grid.Column="4" Spacing="4">
        <TextBlock Text="{x:Static res:Strings.Audit_Entity}" FontWeight="SemiBold" />
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding EntityOptions}" SelectedItem="{Binding SelectedEntity}"
                  DisplayMemberBinding="{Binding Label, x:DataType=vm:AuditEntityOption}" />
      </StackPanel>
    </Grid>

    <!-- Historial del registro, error de filtros y exportación -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Border IsVisible="{Binding IsHistoryActive}" CornerRadius="12" Padding="10,2,4,2"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding HistoryText}" VerticalAlignment="Center" />
            <Button Content="✕" Padding="8,2" Command="{Binding ClearHistoryCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Audit_ClearHistory}"
                    AutomationProperties.Name="{x:Static res:Strings.Audit_ClearHistory}" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding FilterError}" VerticalAlignment="Center"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   IsVisible="{Binding FilterError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{x:Static res:Strings.Reports_Exporting}" IsVisible="{Binding IsExporting}" VerticalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsExporting}" />
        <Button MinHeight="44" Content="{x:Static res:Strings.Audit_ExportPdf}" Command="{Binding ExportPdfCommand}" />
        <Button MinHeight="44" Content="{x:Static res:Strings.Audit_ExportExcel}" Command="{Binding ExportExcelCommand}" />
      </StackPanel>
    </Grid>

    <!-- Encabezados -->
    <Grid Grid.Row="2" Margin="12,0,392,4" ColumnDefinitions="140,180,110,160,130,130,*">
      <Grid.Styles>
        <Style Selector="TextBlock">
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
      </Grid.Styles>
      <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Audit_ColDate}" />
      <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Audit_ColEvent}" />
      <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Audit_Entity}" />
      <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Audit_Record}" />
      <TextBlock Grid.Column="4" Text="{x:Static res:Strings.Audit_ColUser}" />
      <TextBlock Grid.Column="5" Text="{x:Static res:Strings.Audit_ColAuthorizedBy}" />
      <TextBlock Grid.Column="6" Text="{x:Static res:Strings.Audit_Summary}" />
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,380" ColumnSpacing="12">
      <ListBox Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AuditLogRow">
            <Grid ColumnDefinitions="140,180,110,160,130,130,*" MinHeight="36">
              <Grid.Styles>
                <Style Selector="TextBlock">
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
              </Grid.Styles>
              <TextBlock Grid.Column="0" Text="{Binding DateText}" />
              <TextBlock Grid.Column="1" Text="{Binding EventText}" />
              <TextBlock Grid.Column="2" Text="{Binding EntityText}" />
              <TextBlock Grid.Column="3" Text="{Binding RecordText}" ToolTip.Tip="{Binding RecordText}" />
              <TextBlock Grid.Column="4" Text="{Binding UserName}" />
              <TextBlock Grid.Column="5" Text="{Binding AuthorizedByName}" />
              <TextBlock Grid.Column="6" Text="{Binding SummaryText}" ToolTip.Tip="{Binding SummaryText}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Column="0" Margin="12" Text="{x:Static res:Strings.Audit_NoResults}" TextWrapping="Wrap"
                 IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Top" />

      <!-- Detalle de la entrada seleccionada: solo lectura, sin editar ni borrar -->
      <Border Grid.Column="1" BorderThickness="1" CornerRadius="6" Padding="12"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <Panel>
          <TextBlock Text="{x:Static res:Strings.Audit_SelectEntry}" TextWrapping="Wrap" Opacity="0.7"
                     IsVisible="{Binding !HasSelection}" />
          <ScrollViewer IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10" DataContext="{Binding SelectedRow}" x:DataType="vm:AuditLogRow">
              <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
              <TextBlock Text="{Binding WhoText}" TextWrapping="Wrap" Opacity="0.8" />

              <StackPanel Spacing="2" IsVisible="{Binding HasReason}">
                <TextBlock Text="{x:Static res:Strings.Audit_Reason}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding HasChanges}">
                <TextBlock Text="{x:Static res:Strings.Audit_Changes}" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <Grid.Styles>
                    <Style Selector="TextBlock">
                      <Setter Property="FontWeight" Value="SemiBold" />
                      <Setter Property="Opacity" Value="0.8" />
                    </Style>
                  </Grid.Styles>
                  <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Audit_Field}" />
                  <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Audit_Before}" />
                  <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Audit_After}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Changes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AuditChangeRow">
                      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding Field}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Before}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding After}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="2" IsVisible="{Binding HasDetails}">
                <TextBlock Text="{x:Static res:Strings.Audit_Details}" FontWeight="SemiBold" />
                <SelectableTextBlock Text="{Binding Details}" TextWrapping="Wrap" />
              </StackPanel>

              <Button MinHeight="44" HorizontalAlignment="Left" Content="{x:Static res:Strings.Audit_ViewHistory}"
                      Command="{Binding $parent[UserControl].((vm:AuditLogViewModel)DataContext).ViewHistoryCommand}" />
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Border>
    </Grid>

    <!-- Paginación -->
    <Grid Grid.Row="4" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
      <Grid.Styles>
        <Style Selector="Button.pager">
          <Setter Property="MinWidth" Value="44" />
          <Setter Property="MinHeight" Value="44" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
      </Grid.Styles>
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PageSummary}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <Button Classes="pager" Command="{Binding FirstPageCommand}"
                ToolTip.Tip="{x:Static res:Strings.Products_FirstPage}"
                AutomationProperties.Name="{x:Static res:Strings.Products_FirstPage}">
          <PathIcon Data="{StaticResource Icon.PageFirst}" />
        </Button>
        <Button Classes="pager" Command="{Binding PreviousPageCommand}"
                ToolTip.Tip="{x:Static res:Strings.Products_PreviousPage}"
                AutomationProperties.Name="{x:Static res:Strings.Products_PreviousPage}">
          <PathIcon Data="{StaticResource Icon.PagePrevious}" />
        </Button>
        <Button Classes="pager" Command="{Binding NextPageCommand}"
                ToolTip.Tip="{x:Static res:Strings.Products_NextPage}"
                AutomationProperties.Name="{x:Static res:Strings.Products_NextPage}">
          <PathIcon Data="{StaticResource Icon.PageNext}" />
        </Button>
        <Button Classes="pager" Command="{Binding LastPageCommand}"
                ToolTip.Tip="{x:Static res:Strings.Products_LastPage}"
                AutomationProperties.Name="{x:Static res:Strings.Products_LastPage}">
          <PathIcon Data="{StaticResource Icon.PageLast}" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
