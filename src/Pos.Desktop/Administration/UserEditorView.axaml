<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Administration"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Administration.UserEditorView"
             x:DataType="vm:UserEditorViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="StackPanel.field">
      <Setter Property="Spacing" Value="4" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14" Width="300">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Auth_FullName}" IsRequired="True" />
      <TextBox x:Name="FullNameBox" Text="{Binding FullName}" MaxLength="100" />
      <TextBlock Classes="error" Text="{Binding FullNameError}" IsVisible="{Binding FullNameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Auth_UserName}" IsRequired="True" />
      <TextBox x:Name="UserNameBox" Text="{Binding UserName}" MaxLength="40" />
      <TextBlock Classes="error" Text="{Binding UserNameError}" IsVisible="{Binding UserNameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.UserEditor_Role}" IsRequired="True" />
      <ComboBox x:Name="RoleBox" HorizontalAlignment="Stretch" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                IsEnabled="{Binding CanChangeRoleAndState}"
                DisplayMemberBinding="{Binding Label, x:DataType=vm:RoleOption}" />
      <TextBlock Classes="error" Text="{Binding RoleError}" IsVisible="{Binding RoleError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field" IsVisible="{Binding IsCreateMode}">
      <forms:FieldLabel Text="{x:Static res:Strings.UserEditor_InitialPassword}" IsRequired="True" />
      <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="●" />
      <TextBlock Text="{x:Static res:Strings.UserEditor_InitialPasswordHint}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
      <TextBlock Classes="error" Text="{Binding PasswordError}" IsVisible="{Binding PasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field" IsVisible="{Binding IsCreateMode}">
      <forms:FieldLabel Text="{x:Static res:Strings.Auth_ConfirmPassword}" IsRequired="True" />
      <TextBox x:Name="ConfirmPasswordBox" Text="{Binding ConfirmPassword}" PasswordChar="●" />
      <TextBlock Classes="error" Text="{Binding ConfirmPasswordError}" IsVisible="{Binding ConfirmPasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <CheckBox Content="{x:Static res:Strings.UserEditor_Active}" IsChecked="{Binding IsActive}"
                IsEnabled="{Binding CanChangeRoleAndState}" />
      <TextBlock Text="{x:Static res:Strings.UserEditor_SelfLocked}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                 IsVisible="{Binding IsSelf}" />
    </StackPanel>

    <TextBlock Classes="error" FontSize="13" Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{x:Static res:Strings.Editor_Save}" Command="{Binding SaveCommand}" Classes="accent" MinWidth="100" />
      <Button Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CancelCommand}" MinWidth="100" />
    </StackPanel>
  </StackPanel>
</UserControl>
