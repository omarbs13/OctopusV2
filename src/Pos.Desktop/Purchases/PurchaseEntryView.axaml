<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Purchases"
             xmlns:inv="using:Pos.Desktop.Inventory"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Purchases.PurchaseEntryView"
             x:DataType="vm:PurchaseEntryViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding RegisterCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.total">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <forms:FormHostView Host="{Binding Forms}">
    <forms:FormHostView.ListContent>
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10">
        <!-- Encabezado -->
        <Grid Grid.Row="0" ColumnDefinitions="2*,*,*" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="4">
            <forms:FieldLabel Text="{x:Static res:Strings.Purchase_Supplier}" IsRequired="True" />
            <TextBox Text="{Binding SupplierSearchText}" PlaceholderText="{x:Static res:Strings.Purchase_SupplierSearch}" />
            <ComboBox x:Name="SupplierBox" HorizontalAlignment="Stretch" ItemsSource="{Binding SupplierOptions}"
                      SelectedItem="{Binding SelectedSupplier}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SupplierChoice">
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="error" Text="{Binding SupplierError}" IsVisible="{Binding SupplierError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <forms:FieldLabel Text="{x:Static res:Strings.Purchase_InvoiceNumber}" IsRequired="True" />
            <TextBox x:Name="InvoiceBox" Text="{Binding InvoiceNumber}" MaxLength="50" />
            <TextBlock Classes="error" Text="{Binding InvoiceError}" IsVisible="{Binding InvoiceError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Content="{x:Static res:Strings.Purchase_ViewPurchase}" Command="{Binding ViewDuplicateCommand}"
                    IsVisible="{Binding DuplicatePurchaseId, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <forms:FieldLabel Text="{x:Static res:Strings.Purchase_InvoiceDate}" IsRequired="True" />
            <CalendarDatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding InvoiceDate}"
                                DisplayDateEnd="{Binding MaxInvoiceDate}" />
            <TextBlock Classes="error" Text="{Binding DateError}" IsVisible="{Binding DateError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Grid>

        <!-- Agregar producto: Enter agrega el primero y lleva a la cantidad (SC-003) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Classes="header" Text="{x:Static res:Strings.Purchase_AddProduct}" />
            <TextBox x:Name="ProductSearchBox" Text="{Binding Picker.SearchText}"
                     PlaceholderText="{x:Static res:Strings.Purchase_ProductSearch}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddFirstMatchCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
          </StackPanel>
          <ComboBox Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Picker.Options}" SelectedItem="{Binding Picker.Selected}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="inv:ProductOption">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <!-- Encabezados de la tabla -->
        <Grid Grid.Row="2" Margin="12,0,12,0" ColumnDefinitions="50,*,110,140,140,130,110,44">
          <TextBlock Grid.Column="0" Classes="header" Text="{x:Static res:Strings.Purchase_ColNumber}" />
          <TextBlock Grid.Column="1" Classes="header" Text="{x:Static res:Strings.Purchase_ColProduct}" />
          <TextBlock Grid.Column="2" Classes="header" Text="{x:Static res:Strings.Purchase_ColUnit}" />
          <TextBlock Grid.Column="3" Classes="header" Text="{x:Static res:Strings.Purchase_ColQuantity}" />
          <TextBlock Grid.Column="4" Classes="header" Text="{x:Static res:Strings.Purchase_ColUnitCost}" />
          <TextBlock Grid.Column="5" Classes="header" Text="{x:Static res:Strings.Purchase_ColAmount}" TextAlignment="Right" />
        </Grid>

        <Grid Grid.Row="3">
          <ItemsControl x:Name="LinesControl" ItemsSource="{Binding Lines}">
            <ItemsControl.Template>
              <ControlTemplate>
                <ScrollViewer>
                  <ItemsPresenter />
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PurchaseLineViewModel">
                <Grid Margin="12,4" ColumnDefinitions="50,*,110,140,140,130,110,44" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="{Binding Number}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Sku}" FontSize="12" Opacity="0.7" />
                    <TextBlock Classes="error" Text="{Binding ProductError}" IsVisible="{Binding ProductError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding UnitName}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="3">
                    <TextBox Name="QuantityBox" Text="{Binding QuantityText}" MaxLength="13" TextAlignment="Right" />
                    <TextBlock Classes="error" Text="{Binding QuantityError}" IsVisible="{Binding QuantityError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBox Name="CostBox" Text="{Binding UnitCostText}" MaxLength="12" TextAlignment="Right" />
                    <TextBlock Classes="error" Text="{Binding CostError}" IsVisible="{Binding CostError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <TextBlock Grid.Column="5" Text="{Binding AmountText}" TextAlignment="Right" VerticalAlignment="Center" />
                  <Border Grid.Column="6" IsVisible="{Binding IsBonus}" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{x:Static res:Strings.Purchase_Bonus}" FontSize="12" />
                  </Border>
                  <Button Grid.Column="7" Command="{Binding RemoveCommand}" VerticalAlignment="Center"
                          ToolTip.Tip="{x:Static res:Strings.Purchase_RemoveLine}"
                          AutomationProperties.Name="{x:Static res:Strings.Purchase_RemoveLine}"
                          IsTabStop="False">
                    <TextBlock Text="✕" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Margin="12" Text="{x:Static res:Strings.Purchase_NoLines}" IsVisible="{Binding HasNoLines}"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.75" />
        </Grid>

        <!-- Pie: los importes los calcula CalculatePurchaseTotals (Principio III) -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="12,0">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Classes="error" Text="{Binding LinesError}" IsVisible="{Binding LinesError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="error" Text="{Binding TotalsError}" IsVisible="{Binding TotalsError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="error" FontSize="13" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <Grid Grid.Column="1" ColumnDefinitions="Auto,160" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.Purchase_Subtotal}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubtotalText}" TextAlignment="Right" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.Purchase_Tax}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TaxText}" MaxLength="12" TextAlignment="Right" PlaceholderText="0.00" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="error" Text="{Binding TaxError}" IsVisible="{Binding TaxError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Classes="total" Text="{x:Static res:Strings.Purchase_Total}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="total" Text="{Binding TotalText}" TextAlignment="Right" />
          </Grid>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Classes="accent" MinWidth="160" MinHeight="44" Content="{x:Static res:Strings.Purchase_Register}" Command="{Binding RegisterCommand}" />
          <Button MinWidth="120" MinHeight="44" Content="{x:Static res:Strings.Purchase_Discard}" Command="{Binding DiscardCommand}" />
        </StackPanel>
      </Grid>
    </forms:FormHostView.ListContent>
  </forms:FormHostView>
</UserControl>
