<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Purchases"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Purchases.SupplierFormView"
             x:DataType="vm:SupplierFormViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="StackPanel.field">
      <Setter Property="Spacing" Value="4" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14" Width="320">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Supplier_Name}" IsRequired="True" />
      <TextBox x:Name="NameBox" Text="{Binding Name}" MaxLength="150" />
      <TextBlock Classes="error" Text="{Binding NameError}" IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Supplier_TaxId}" />
      <TextBox x:Name="TaxIdBox" Text="{Binding TaxId}" MaxLength="20" />
      <TextBlock Classes="error" Text="{Binding TaxIdError}" IsVisible="{Binding TaxIdError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Supplier_Phone}" />
      <TextBox x:Name="PhoneBox" Text="{Binding Phone}" MaxLength="30" />
      <TextBlock Classes="error" Text="{Binding PhoneError}" IsVisible="{Binding PhoneError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Supplier_Email}" />
      <TextBox x:Name="EmailBox" Text="{Binding Email}" MaxLength="254" />
      <TextBlock Classes="error" Text="{Binding EmailError}" IsVisible="{Binding EmailError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Supplier_Address}" />
      <TextBox x:Name="AddressBox" Text="{Binding Address}" MaxLength="300" AcceptsReturn="True" TextWrapping="Wrap" Height="72" />
      <TextBlock Classes="error" Text="{Binding AddressError}" IsVisible="{Binding AddressError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Supplier_PaymentTerms}" IsRequired="True" />
      <ComboBox x:Name="TermsBox" HorizontalAlignment="Stretch" ItemsSource="{Binding TermsOptions}" SelectedItem="{Binding SelectedTerms}"
                DisplayMemberBinding="{Binding Label, x:DataType=vm:PaymentTermsOption}" />
    </StackPanel>

    <StackPanel Classes="field" IsEnabled="{Binding IsCredit}">
      <forms:FieldLabel Text="{x:Static res:Strings.Supplier_CreditDays}" IsRequired="{Binding IsCredit}" />
      <TextBox x:Name="CreditDaysBox" Text="{Binding CreditDaysText}" MaxLength="3" />
      <TextBlock Classes="error" Text="{Binding CreditDaysError}" IsVisible="{Binding CreditDaysError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <TextBlock Classes="error" FontSize="13" Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{x:Static res:Strings.Editor_Save}" Command="{Binding SaveCommand}" Classes="accent" MinWidth="100" />
      <Button Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CancelCommand}" MinWidth="100" />
    </StackPanel>
  </StackPanel>
</UserControl>
