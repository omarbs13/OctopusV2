<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Settings"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Settings.DrawerReasonView"
             x:DataType="vm:DrawerReasonViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ConfirmCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>

  <Border Padding="16" CornerRadius="6" BorderThickness="1" Width="460"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
    <StackPanel Spacing="10">
      <TextBlock Text="{x:Static res:Strings.Drawer_Title}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{x:Static res:Strings.Drawer_Description}" TextWrapping="Wrap" />

      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.Drawer_Reason}" IsRequired="True" />
        <TextBox x:Name="ReasonBox" Text="{Binding Reason}" MaxLength="200"
                 AcceptsReturn="False" TextWrapping="Wrap" MinHeight="44">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBlock Text="{Binding ReasonError}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   IsVisible="{Binding ReasonError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="accent" MinHeight="44" MinWidth="130"
                Content="{x:Static res:Strings.Drawer_Open}" Command="{Binding ConfirmCommand}" />
        <Button MinHeight="44" MinWidth="110"
                Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CloseCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
