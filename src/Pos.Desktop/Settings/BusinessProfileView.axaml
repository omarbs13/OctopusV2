<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Settings"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:common="using:Pos.Desktop.Common"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Settings.BusinessProfileView"
             x:DataType="vm:BusinessProfileViewModel">

  <ScrollViewer>
    <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Text="{x:Static res:Strings.Nav_BusinessProfile}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{x:Static res:Strings.BusinessProfile_Description}" TextWrapping="Wrap" Opacity="0.8" />

      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.BusinessProfile_TradeName}" IsRequired="True" />
        <TextBox Text="{Binding TradeName}" MaxLength="80" />
        <TextBlock Classes="error" Text="{Binding TradeNameError}" TextWrapping="Wrap"
                   IsVisible="{Binding TradeNameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.BusinessProfile_Address}" IsRequired="True" />
        <TextBox Text="{Binding Address}" MaxLength="200" AcceptsReturn="False" TextWrapping="Wrap" />
        <TextBlock Classes="error" Text="{Binding AddressError}" TextWrapping="Wrap"
                   IsVisible="{Binding AddressError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.BusinessProfile_Phone}" IsRequired="True" />
        <TextBox Text="{Binding Phone}" MaxLength="30" />
        <TextBlock Classes="error" Text="{Binding PhoneError}" TextWrapping="Wrap"
                   IsVisible="{Binding PhoneError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="{x:Static res:Strings.BusinessProfile_TaxId}" />
        <TextBox Text="{Binding TaxId}" MaxLength="13" />
        <TextBlock Classes="error" Text="{Binding TaxIdError}" TextWrapping="Wrap"
                   IsVisible="{Binding TaxIdError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="{x:Static res:Strings.BusinessProfile_Footer}" />
        <TextBox Text="{Binding FooterMessage}" MaxLength="200" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
        <TextBlock Classes="error" Text="{Binding FooterMessageError}" TextWrapping="Wrap"
                   IsVisible="{Binding FooterMessageError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="{x:Static res:Strings.BusinessProfile_Logo}" />
        <Border Width="240" Height="120" HorizontalAlignment="Left" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <Panel>
            <Image x:Name="LogoBox" Stretch="Uniform"
                   Source="{Binding PreviewLogo, Converter={x:Static common:ThumbnailConverter.Instance}}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                        IsVisible="{Binding #LogoBox.Source, Converter={x:Static ObjectConverters.IsNull}}">
              <PathIcon Data="{StaticResource Icon.ImageOff}" Width="32" Height="32" Opacity="0.5" />
              <TextBlock Text="{x:Static res:Strings.BusinessProfile_NoLogo}" Opacity="0.7" HorizontalAlignment="Center" />
            </StackPanel>
          </Panel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding SelectLogoCommand}" Content="{x:Static res:Strings.BusinessProfile_SelectLogo}" />
          <Button Command="{Binding RemoveLogoCommand}" Content="{x:Static res:Strings.BusinessProfile_RemoveLogo}" />
        </StackPanel>
        <TextBlock Classes="error" Text="{Binding LogoError}" TextWrapping="Wrap"
                   IsVisible="{Binding LogoError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Classes="accent" MinHeight="44" MinWidth="140" Command="{Binding SaveCommand}"
                Content="{x:Static res:Strings.BusinessProfile_Save}" />
        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap"
                   IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
