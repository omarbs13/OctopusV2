<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Auth"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Auth.AdminAuthorizationView"
             x:DataType="vm:AdminAuthorizationViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>

  <Border Padding="20" CornerRadius="8" BorderThickness="1" Width="420"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
    <StackPanel Spacing="12">
      <TextBlock Text="{x:Static res:Strings.Auth_AuthorizeTitle}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />

      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.Auth_UserName}" IsRequired="True" />
        <TextBox x:Name="UserNameBox" Text="{Binding UserName}" MaxLength="40" MinHeight="44">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AuthorizeCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
      </StackPanel>

      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.Auth_Password}" IsRequired="True" />
        <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="●" MinHeight="44">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding AuthorizeCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
      </StackPanel>

      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="accent" MinHeight="44" MinWidth="130" HorizontalContentAlignment="Center"
                Content="{x:Static res:Strings.Auth_Authorize}" Command="{Binding AuthorizeCommand}" />
        <Button MinHeight="44" MinWidth="110" HorizontalContentAlignment="Center"
                Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CancelCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
