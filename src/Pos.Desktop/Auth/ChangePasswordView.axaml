<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Auth"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Auth.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <Border Padding="24" CornerRadius="8" BorderThickness="1" Width="400"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
    <StackPanel Spacing="12">
      <TextBlock Text="{x:Static res:Strings.Auth_ChangePasswordTitle}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{x:Static res:Strings.Auth_ChangePasswordMandatory}" TextWrapping="Wrap"
                 IsVisible="{Binding IsMandatory}" />

      <StackPanel Spacing="4" IsVisible="{Binding AsksCurrentPassword}">
        <forms:FieldLabel Text="{x:Static res:Strings.Auth_CurrentPassword}" IsRequired="True" />
        <TextBox x:Name="CurrentBox" Text="{Binding CurrentPassword}" PasswordChar="●" MinHeight="40" />
        <TextBlock Classes="error" Text="{Binding CurrentPasswordError}" IsVisible="{Binding CurrentPasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.Auth_NewPassword}" IsRequired="True" />
        <TextBox x:Name="NewBox" Text="{Binding NewPassword}" PasswordChar="●" MinHeight="40" />
        <TextBlock Classes="error" Text="{Binding NewPasswordError}" IsVisible="{Binding NewPasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <forms:FieldLabel Text="{x:Static res:Strings.Auth_ConfirmNewPassword}" IsRequired="True" />
        <TextBox x:Name="ConfirmBox" Text="{Binding ConfirmPassword}" PasswordChar="●" MinHeight="40">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBlock Classes="error" Text="{Binding ConfirmPasswordError}" IsVisible="{Binding ConfirmPasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <TextBlock Classes="error" FontSize="14" Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="accent" MinHeight="44" MinWidth="150" HorizontalContentAlignment="Center"
                Content="{Binding SaveText}" Command="{Binding SaveCommand}" />
        <Button MinHeight="44" MinWidth="110" HorizontalContentAlignment="Center"
                Content="{Binding CancelText}" Command="{Binding CancelCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
