<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Discounts"
             xmlns:reports="using:Pos.Desktop.Reports"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:sales="using:Pos.Desktop.Sales"
             x:Class="Pos.Desktop.Discounts.DiscountReportView"
             x:DataType="vm:DiscountReportViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" Margin="0,0,12,0">
      <TextBlock Text="{x:Static res:Strings.DiscountReport_Title}" FontSize="22" FontWeight="SemiBold" />

      <!-- Filtros -->
      <ContentControl Content="{Binding Picker}" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <StackPanel Spacing="4" MinWidth="220">
          <TextBlock Text="{x:Static res:Strings.Reports_Cashier}" FontWeight="SemiBold" />
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CashierOptions}" SelectedItem="{Binding SelectedCashier}"
                    DisplayMemberBinding="{Binding Label, x:DataType=sales:CashierOption}" />
        </StackPanel>
        <StackPanel Spacing="4" MinWidth="180">
          <TextBlock Text="{x:Static res:Strings.DiscountReport_Kind}" FontWeight="SemiBold" />
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}"
                    DisplayMemberBinding="{Binding Label, x:DataType=vm:DiscountKindOption}" />
        </StackPanel>
      </StackPanel>

      <!-- Exportar con los formatos de 009 -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button MinHeight="44" Content="{x:Static res:Strings.Reports_ExportPdf}" Command="{Binding ExportPdfCommand}" />
        <Button MinHeight="44" Content="{x:Static res:Strings.Reports_ExportExcel}" Command="{Binding ExportExcelCommand}" />
        <TextBlock Text="{x:Static res:Strings.Reports_Exporting}" IsVisible="{Binding IsExporting}" VerticalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsExporting}" />
      </StackPanel>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

      <TextBlock Text="{x:Static res:Strings.Reports_NoData}" IsVisible="{Binding IsEmpty}"
                 FontSize="16" Margin="0,24" HorizontalAlignment="Center" />

      <StackPanel Spacing="12" IsVisible="{Binding HasData}">
        <WrapPanel>
          <reports:MetricCard Label="{x:Static res:Strings.DiscountReport_Total}" Value="{Binding TotalText}" />
          <reports:MetricCard Label="{x:Static res:Strings.DiscountReport_Count}" Value="{Binding CountText}" />
        </WrapPanel>

        <Grid ColumnDefinitions="100,140,160,90,90,110,160,110" Margin="12,0">
          <Grid.Styles>
            <Style Selector="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /></Style>
          </Grid.Styles>
          <TextBlock Grid.Column="0" Text="{x:Static res:Strings.DiscountReport_ColFolio}" />
          <TextBlock Grid.Column="1" Text="{x:Static res:Strings.DiscountReport_ColDate}" />
          <TextBlock Grid.Column="2" Text="{x:Static res:Strings.DiscountReport_ColCashier}" />
          <TextBlock Grid.Column="3" Text="{x:Static res:Strings.DiscountReport_ColKind}" />
          <TextBlock Grid.Column="4" Text="{x:Static res:Strings.DiscountReport_ColValue}" TextAlignment="Right" />
          <TextBlock Grid.Column="5" Text="{x:Static res:Strings.DiscountReport_ColAmount}" TextAlignment="Right" />
          <TextBlock Grid.Column="6" Text="{x:Static res:Strings.DiscountReport_ColAuthorizedBy}" Margin="12,0,0,0" />
          <TextBlock Grid.Column="7" Text="{x:Static res:Strings.DiscountReport_ColCoupon}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DiscountReportRowItem">
              <Grid ColumnDefinitions="100,140,160,90,90,110,160,110" Margin="12,0" MinHeight="36">
                <Grid.Styles>
                  <Style Selector="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>
                </Grid.Styles>
                <TextBlock Grid.Column="0" Text="{Binding Folio}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding DateText}" />
                <TextBlock Grid.Column="2" Text="{Binding Cashier}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding KindText}" />
                <TextBlock Grid.Column="4" Text="{Binding ValueText}" TextAlignment="Right" />
                <TextBlock Grid.Column="5" Text="{Binding AmountText}" TextAlignment="Right" FontWeight="SemiBold" />
                <TextBlock Grid.Column="6" Text="{Binding AuthorizedBy}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="7" Text="{Binding Coupon}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock VerticalAlignment="Center" Text="{Binding PageSummary}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button MinWidth="44" MinHeight="44" Command="{Binding PreviousPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_PreviousPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_PreviousPage}">
              <PathIcon Data="{StaticResource Icon.PagePrevious}" />
            </Button>
            <Button MinWidth="44" MinHeight="44" Command="{Binding NextPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_NextPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_NextPage}">
              <PathIcon Data="{StaticResource Icon.PageNext}" />
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
