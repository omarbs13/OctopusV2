<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Discounts"
             xmlns:products="using:Pos.Desktop.Products"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Discounts.CouponListView"
             x:DataType="vm:CouponListViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCouponCommand}" />
    <KeyBinding Gesture="Alt+PageUp" Command="{Binding PreviousPageCommand}" />
    <KeyBinding Gesture="Alt+PageDown" Command="{Binding NextPageCommand}" />
  </UserControl.KeyBindings>

  <forms:FormHostView Host="{Binding Forms}">
    <forms:FormHostView.ListContent>
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,0,12">
          <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding SearchText}"
                   PlaceholderText="{x:Static res:Strings.Coupon_SearchPlaceholder}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchNowCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <ComboBox Grid.Column="1" Margin="12,0,0,0" MinWidth="160"
                    ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"
                    DisplayMemberBinding="{Binding Label, x:DataType=vm:CouponStatusOption}" />
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="{x:Static res:Strings.Coupon_New}" Command="{Binding NewCouponCommand}" />
            <Button Content="{x:Static res:Strings.Coupon_Edit}" Command="{Binding EditCommand}" />
            <Button Content="{Binding ToggleText}" Command="{Binding ToggleActiveCommand}" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="12,0,12,4" ColumnDefinitions="*,110,200,110,80,90">
          <Grid.Styles>
            <Style Selector="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /></Style>
          </Grid.Styles>
          <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Coupon_ColCode}" />
          <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Coupon_ColDiscount}" TextAlignment="Right" />
          <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Coupon_ColValidity}" Margin="12,0,0,0" />
          <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Coupon_ColStatus}" />
          <TextBlock Grid.Column="4" Text="{x:Static res:Strings.Coupon_ColUses}" TextAlignment="Right" />
          <TextBlock Grid.Column="5" Text="{x:Static res:Strings.Coupon_ColRemaining}" TextAlignment="Right" />
        </Grid>

        <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" DoubleTapped="OnRowDoubleTapped">
          <ListBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding EditCommand}" />
          </ListBox.KeyBindings>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CouponRow">
              <Grid ColumnDefinitions="*,110,200,110,80,90" MinHeight="40"
                    Opacity="{Binding IsActive, Converter={x:Static products:InactiveOpacityConverter.Instance}}">
                <Grid.Styles>
                  <Style Selector="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>
                </Grid.Styles>
                <TextBlock Grid.Column="0" Text="{Binding Code}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding DiscountText}" TextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{Binding ValidityText}" Margin="12,0,0,0" />
                <TextBlock Grid.Column="3" Text="{Binding StatusText}" />
                <TextBlock Grid.Column="4" Text="{Binding UsesText}" TextAlignment="Right" />
                <TextBlock Grid.Column="5" Text="{Binding RemainingText}" TextAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Margin="12" Text="{x:Static res:Strings.Coupon_Empty}"
                   IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Top" />

        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding PageSummary}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button MinWidth="44" MinHeight="44" Command="{Binding PreviousPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_PreviousPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_PreviousPage}">
              <PathIcon Data="{StaticResource Icon.PagePrevious}" />
            </Button>
            <Button MinWidth="44" MinHeight="44" Command="{Binding NextPageCommand}"
                    ToolTip.Tip="{x:Static res:Strings.Products_NextPage}"
                    AutomationProperties.Name="{x:Static res:Strings.Products_NextPage}">
              <PathIcon Data="{StaticResource Icon.PageNext}" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </forms:FormHostView.ListContent>
  </forms:FormHostView>
</UserControl>
