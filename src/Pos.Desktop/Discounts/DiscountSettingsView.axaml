<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Discounts"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Discounts.DiscountSettingsView"
             x:DataType="vm:DiscountSettingsViewModel">

  <StackPanel Spacing="12" MaxWidth="520" HorizontalAlignment="Left">
    <TextBlock Text="{x:Static res:Strings.DiscountSettings_Title}" FontSize="22" FontWeight="SemiBold" />
    <StackPanel Spacing="4">
      <forms:FieldLabel Text="{x:Static res:Strings.DiscountSettings_Limit}" IsRequired="True" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="LimitBox" Width="120" MinHeight="44" Text="{Binding LimitText}" MaxLength="6">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Classes="accent" MinHeight="44" MinWidth="110"
                Content="{x:Static res:Strings.DiscountSettings_Save}" Command="{Binding SaveCommand}" />
      </StackPanel>
      <TextBlock Text="{x:Static res:Strings.DiscountSettings_Hint}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               IsVisible="{Binding MessageIsError}" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding !MessageIsError}" />
  </StackPanel>
</UserControl>
