<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pos.Desktop.Discounts"
             xmlns:sales="using:Pos.Desktop.Sales"
             xmlns:res="using:Pos.Desktop.Resources"
             xmlns:forms="using:Pos.Desktop.Forms"
             x:Class="Pos.Desktop.Discounts.CouponFormView"
             x:DataType="vm:CouponFormViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="StackPanel.field">
      <Setter Property="Spacing" Value="4" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14" Width="320">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />

    <!-- Con usos registrados: código, modalidad y valor de solo lectura (FR-010) -->
    <Border IsVisible="{Binding HasUses}" Padding="8" CornerRadius="4"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
      <TextBlock Text="{x:Static res:Strings.Coupon_UsedNote}" TextWrapping="Wrap" />
    </Border>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Coupon_Code}" IsRequired="True" />
      <TextBox Text="{Binding Code}" MaxLength="30" IsReadOnly="{Binding HasUses}" />
      <TextBlock Classes="error" Text="{Binding CodeError}" IsVisible="{Binding CodeError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Coupon_Mode}" IsRequired="True" />
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                IsEnabled="{Binding CanEditValue}"
                DisplayMemberBinding="{Binding Label, x:DataType=sales:DiscountModeOption}" />
    </StackPanel>

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Coupon_Value}" IsRequired="True" />
      <TextBox Text="{Binding ValueText}" MaxLength="12" IsReadOnly="{Binding HasUses}" />
      <TextBlock Classes="error" Text="{Binding ValueError}" IsVisible="{Binding ValueError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <Grid ColumnDefinitions="*,12,*">
      <StackPanel Classes="field">
        <forms:FieldLabel Text="{x:Static res:Strings.Coupon_StartsOn}" IsRequired="True" />
        <CalendarDatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding StartsOn}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Classes="field">
        <forms:FieldLabel Text="{x:Static res:Strings.Coupon_EndsOn}" IsRequired="True" />
        <CalendarDatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding EndsOn}" />
      </StackPanel>
    </Grid>
    <TextBlock Classes="error" Text="{Binding DatesError}" IsVisible="{Binding DatesError, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <StackPanel Classes="field">
      <forms:FieldLabel Text="{x:Static res:Strings.Coupon_UsageLimit}" />
      <TextBox Text="{Binding UsageLimitText}" MaxLength="9" />
      <TextBlock Classes="error" Text="{Binding UsageLimitError}" IsVisible="{Binding UsageLimitError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <TextBlock Classes="error" FontSize="13" Text="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{x:Static res:Strings.Editor_Save}" Command="{Binding SaveCommand}" Classes="accent" MinWidth="100" />
      <Button Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CancelCommand}" MinWidth="100" />
    </StackPanel>
  </StackPanel>
</UserControl>
